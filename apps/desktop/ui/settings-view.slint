import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, SurfaceButton, NavItem, ThemeChoice } from "design-system.slint";
import { SettingToggle } from "settings-controls.slint";
import { HotkeySettings } from "hotkey-settings.slint";
import { OcrModelItem } from "models.slint";

component ToggleSettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 72px;
    border-radius: 12px;
    background: Theme.surface-raised;
    border-color: Theme.border;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            spacing: 3px;
            Text { text: root.title; color: Theme.text; font-size: 12px; font-weight: 650; }
            Text { text: root.detail; color: Theme.text-muted; font-size: 10px; wrap: word-wrap; }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        SettingToggle {
            checked: root.checked;
            enabled: root.enabled;
            toggled(value) => { root.toggled(value); }
        }
    }
}

component ChoiceSettingGroup inherits Rectangle {
    in property <bool> stacked: false;
    in property <string> selected-key;
    in property <string> first-key;
    in property <string> first-label;
    in property <string> first-detail;
    in property <string> second-key;
    in property <string> second-label;
    in property <string> second-detail;
    in property <string> third-key;
    in property <string> third-label;
    in property <string> third-detail;
    callback chosen(string);

    height: root.stacked ? 280px : 94px;
    background: transparent;

    if !root.stacked: HorizontalLayout {
        spacing: 12px;
        ThemeChoice {
            label: root.first-label;
            detail: root.first-detail;
            selected: root.selected-key == root.first-key;
            chosen => { root.chosen(root.first-key); }
        }
        ThemeChoice {
            label: root.second-label;
            detail: root.second-detail;
            selected: root.selected-key == root.second-key;
            chosen => { root.chosen(root.second-key); }
        }
        ThemeChoice {
            label: root.third-label;
            detail: root.third-detail;
            selected: root.selected-key == root.third-key;
            chosen => { root.chosen(root.third-key); }
        }
    }

    if root.stacked: VerticalLayout {
        spacing: 8px;
        ThemeChoice {
            label: root.first-label;
            detail: root.first-detail;
            selected: root.selected-key == root.first-key;
            chosen => { root.chosen(root.first-key); }
        }
        ThemeChoice {
            label: root.second-label;
            detail: root.second-detail;
            selected: root.selected-key == root.second-key;
            chosen => { root.chosen(root.second-key); }
        }
        ThemeChoice {
            label: root.third-label;
            detail: root.third-detail;
            selected: root.selected-key == root.third-key;
            chosen => { root.chosen(root.third-key); }
        }
    }
}

export component SettingsView inherits Rectangle {
    in-out property <string> page: "general";
    in property <string> platform-name;
    in property <string> hotkey-name;
    in property <string> hotkey-configured-name: "PrtSc";
    in property <string> hotkey-backend-name: @tr("Unknown backend");
    in property <bool> hotkey-portal-managed: false;
    in property <bool> hotkey-active: false;
    in property <bool> hotkey-registration-pending: false;
    in property <string> ocr-engine-name;
    in property <bool> ocr-engine-enabled: false;
    in property <[OcrModelItem]> ocr-models;
    in property <bool> ocr-running;
    in property <string> ocr-model-busy-id;
    in property <float> ocr-model-progress;
    in property <string> ocr-model-progress-label;
    in property <bool> ocr-model-cancellable;
    in property <string> ocr-model-error-id;
    in property <string> ocr-model-error-text;
    in property <bool> has-capture: false;
    in property <string> export-default-directory: "";
    in property <bool> export-remember-last-directory: true;
    in property <bool> export-copy-after-capture: true;
    in property <bool> export-close-after-copy: true;
    in property <bool> export-close-after-save: true;
    in property <string> language-mode: "system";

    private property <bool> compact-layout: root.width < 980px;
    private property <bool> narrow-layout: root.width < 876px;
    private property <bool> stack-choice-cards: root.width < 900px;
    private property <length> sidebar-width: root.narrow-layout ? 76px : root.compact-layout ? 204px : 244px;
    private property <length> content-padding: root.narrow-layout ? 18px : root.compact-layout ? 24px : 34px;
    private property <length> content-top: root.compact-layout ? 84px : 92px;

    callback close-requested();
    callback capture-requested();
    callback hotkey-register-requested();
    callback hotkey-binding-requested(bool, bool, bool, bool, string);
    callback hotkey-reset-requested();
    callback model-download-requested(string);
    callback model-cancel-requested(string);
    callback model-enable-requested(string);
    callback model-delete-requested(string);
    callback export-directory-requested();
    callback export-directory-reset-requested();
    callback export-behavior-change-requested(bool, bool, bool, bool);
    callback language-change-requested(string);

    background: Theme.window;

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.sidebar-width;
        height: parent.height - 58px;
        background: Theme.surface;
        border-color: Theme.border;
        border-width: 1px;

        VerticalLayout {
            padding-left: root.narrow-layout ? 8px : 14px;
            padding-right: root.narrow-layout ? 8px : 14px;
            padding-top: root.narrow-layout ? 14px : 22px;
            padding-bottom: 18px;
            spacing: 8px;

            HorizontalLayout {
                height: 54px;
                spacing: root.narrow-layout ? 0px : 10px;
                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 11px;
                    background: Theme.accent;
                    Text {
                        text: "Az";
                        color: Theme.on-accent;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    visible: !root.narrow-layout;
                    spacing: 2px;
                    Text { text: "Azusa Lens"; color: Theme.text; font-size: 14px; font-weight: 700; }
                    Text { text: @tr("Settings & Management"); color: Theme.text-faint; font-size: 10px; }
                }
            }

            Rectangle { height: 8px; background: transparent; }
            NavItem { label: root.narrow-layout ? "⚙" : @tr("⚙  General & Appearance"); selected: root.page == "general"; chosen => { root.page = "general"; } }
            NavItem { label: root.narrow-layout ? "⌨" : @tr("⌨  Shortcuts"); selected: root.page == "hotkeys"; chosen => { root.page = "hotkeys"; } }
            NavItem { label: root.narrow-layout ? "⌗" : @tr("⌗  Capture & Annotation"); selected: root.page == "capture"; chosen => { root.page = "capture"; } }
            NavItem { label: root.narrow-layout ? "▱" : @tr("▱  Save & Export"); selected: root.page == "export"; chosen => { root.page = "export"; } }
            NavItem { label: root.narrow-layout ? "OCR" : @tr("OCR  OCR Models"); selected: root.page == "ocr"; chosen => { root.page = "ocr"; } }
            NavItem { label: root.narrow-layout ? "ⓘ" : @tr("ⓘ  About"); selected: root.page == "about"; chosen => { root.page = "about"; } }

            Rectangle { vertical-stretch: 1; background: transparent; }

            Rectangle {
                visible: !root.narrow-layout;
                height: 74px;
                border-radius: 12px;
                background: Theme.surface-raised;
                border-color: Theme.border;
                border-width: 1px;
                VerticalLayout {
                    padding: 11px;
                    spacing: 4px;
                    Text { text: @tr("Quick capture"); color: Theme.text; font-size: 11px; font-weight: 650; }
                    Text { text: root.hotkey-name; color: Theme.text-muted; font-size: 9px; overflow: elide; }
                    Text { text: @tr("You can also start a capture from the tray menu."); color: Theme.text-faint; font-size: 9px; }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.capture-requested(); } }
            }
        }
    }

    Rectangle {
        x: root.sidebar-width;
        y: 0px;
        width: parent.width - root.sidebar-width;
        height: parent.height - 58px;
        background: Theme.surface;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 74px;
            background: transparent;

            VerticalLayout {
                x: root.content-padding;
                y: root.compact-layout ? 14px : 18px;
                width: parent.width - 2 * root.content-padding;
                height: 50px;
                spacing: 3px;
                Text {
                    text: root.page == "general" ? @tr("General & Appearance")
                        : root.page == "hotkeys" ? @tr("Shortcuts")
                        : root.page == "capture" ? @tr("Capture & Annotation")
                        : root.page == "export" ? @tr("Save & Export")
                        : root.page == "ocr" ? @tr("OCR Models")
                        : @tr("About Azusa Lens");
                    color: Theme.text;
                    font-size: root.compact-layout ? 21px : 24px;
                    font-weight: 700;
                }
                Text {
                    text: root.page == "general" ? @tr("Control application appearance and desktop workflow")
                        : root.page == "hotkeys" ? @tr("Record and manage the global shortcut for quick capture")
                        : root.page == "capture" ? @tr("Adjust capture and annotation behavior")
                        : root.page == "export" ? @tr("Manage save locations, clipboard, and completion actions")
                        : root.page == "ocr" ? @tr("Download and enable models to recognize text in captures")
                        : @tr("Lightweight, local-first capture and recognition tool");
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        if root.page == "general": general-scroll := ScrollView {
            x: root.content-padding;
            y: root.content-top;
            width: parent.width - 2 * root.content-padding;
            height: parent.height - root.content-top - 16px;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;

            VerticalLayout {
                width: general-scroll.visible-width;
                spacing: 16px;

                Text { text: @tr("Appearance"); color: Theme.text; font-size: 15px; font-weight: 650; }
                Text { text: @tr("Supports light, dark, and automatic system appearance."); color: Theme.text-muted; font-size: 11px; }
                ChoiceSettingGroup {
                    stacked: root.stack-choice-cards;
                    selected-key: Theme.mode;
                    first-key: "system";
                    first-label: @tr("Follow system");
                    first-detail: @tr("Use the current system appearance and switch with it.");
                    second-key: "light";
                    second-label: @tr("Light");
                    second-detail: @tr("Bright background with high-contrast controls.");
                    third-key: "dark";
                    third-label: @tr("Dark");
                    third-detail: @tr("Reduce glare for night use and focused work.");
                    chosen(mode) => { Theme.mode = mode; }
                }

                Text { text: @tr("Language"); color: Theme.text; font-size: 15px; font-weight: 650; }
                Text { text: @tr("Choose the language used by Azusa Lens."); color: Theme.text-muted; font-size: 11px; }
                ChoiceSettingGroup {
                    stacked: root.stack-choice-cards;
                    selected-key: root.language-mode;
                    first-key: "system";
                    first-label: @tr("Follow system");
                    first-detail: @tr("Use the operating system language.");
                    second-key: "zh-CN";
                    second-label: @tr("Simplified Chinese");
                    second-detail: @tr("Use Simplified Chinese.");
                    third-key: "en";
                    third-label: @tr("English");
                    third-detail: @tr("Use English.");
                    chosen(mode) => { root.language-change-requested(mode); }
                }

                Rectangle { height: 1px; background: Theme.border; }
                Text { text: @tr("Desktop workflow"); color: Theme.text; font-size: 15px; font-weight: 650; }

                Rectangle {
                    height: 96px;
                    border-radius: 12px;
                    background: Theme.surface-raised;
                    border-color: Theme.border;
                    border-width: 1px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 5px;
                        Text { text: @tr("Lives in the tray"); color: Theme.text; font-size: 13px; font-weight: 650; }
                        Text { text: @tr("The tray icon is Azusa Lens's persistent entry point for opening settings or starting a region capture."); color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
                        Text { text: @tr("Current platform: ") + root.platform-name; color: Theme.text-faint; font-size: 10px; }
                    }
                }

                Rectangle {
                    height: 96px;
                    border-radius: 12px;
                    background: Theme.surface-raised;
                    border-color: Theme.border;
                    border-width: 1px;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 5px;
                        Text { text: @tr("Local-first OCR"); color: Theme.text; font-size: 13px; font-weight: 650; }
                        Text { text: @tr("The first recognition never downloads a model automatically; download and enable one manually on the OCR Models page."); color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
                        Text { text: @tr("Current model: ") + root.ocr-engine-name; color: Theme.text-faint; font-size: 10px; }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }

        if root.page == "hotkeys": HotkeySettings {
            x: root.content-padding;
            y: root.content-top;
            width: parent.width - 2 * root.content-padding;
            height: parent.height - root.content-top - 16px;
            configured-name: root.hotkey-configured-name;
            effective-name: root.hotkey-name;
            backend-name: root.hotkey-backend-name;
            portal-managed: root.hotkey-portal-managed;
            active: root.hotkey-active;
            registration-pending: root.hotkey-registration-pending;
            register-requested => { root.hotkey-register-requested(); }
            binding-requested(control, alt, shift, meta, key-text) => {
                root.hotkey-binding-requested(control, alt, shift, meta, key-text);
            }
            reset-requested => { root.hotkey-reset-requested(); }
        }

        if root.page == "capture": capture-scroll := ScrollView {
            x: root.content-padding; y: root.content-top;
            width: parent.width - 2 * root.content-padding;
            height: parent.height - root.content-top - 16px;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;
            VerticalLayout {
                width: capture-scroll.visible-width;
                spacing: 14px;
                Rectangle {
                    height: 104px; border-radius: 12px; background: Theme.surface-raised; border-color: Theme.border; border-width: 1px;
                    VerticalLayout {
                        padding: 14px; spacing: 6px;
                        Text { text: @tr("Capture interface"); color: Theme.text; font-size: 13px; font-weight: 650; }
                        Text { text: @tr("The capture stays visually central; common annotation tools float beside the canvas and properties appear contextually."); color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
                        Text { text: @tr("Completion actions stay in the lower-right: copy, save, OCR, and more."); color: Theme.text-faint; font-size: 10px; }
                    }
                }
                Rectangle {
                    height: 104px; border-radius: 12px; background: Theme.surface-raised; border-color: Theme.border; border-width: 1px;
                    VerticalLayout {
                        padding: 14px; spacing: 6px;
                        Text { text: @tr("Capture session retention"); color: Theme.text; font-size: 13px; font-weight: 650; }
                        Text { text: root.has-capture ? @tr("A capture session is currently available and remains available after capture actions.") : @tr("No capture session is currently available. Start a region capture to work in the overlay."); color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
                    }
                }
                SurfaceButton { width: 132px; label: @tr("Start region capture"); primary: true; clicked => { root.capture-requested(); } }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }

        if root.page == "export": export-scroll := ScrollView {
            x: root.content-padding; y: root.content-top;
            width: parent.width - 2 * root.content-padding;
            height: parent.height - root.content-top - 16px;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;
            VerticalLayout {
                width: export-scroll.visible-width;
                spacing: 12px;

                Rectangle {
                    height: root.compact-layout ? 124px : 108px;
                    border-radius: 12px;
                    background: Theme.surface-raised;
                    border-color: Theme.border;
                    border-width: 1px;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 10px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            Text { text: @tr("Quick save directory"); color: Theme.text; font-size: 13px; font-weight: 650; }
                            Text {
                                text: root.export-default-directory == "" ? @tr("System Pictures / Screenshots") : root.export-default-directory;
                                color: Theme.text-muted;
                                font-size: 10px;
                                overflow: elide;
                            }
                            Text { text: @tr("Save writes directly to this folder; Save As can choose another location. Default filenames use local date and time."); color: Theme.text-faint; font-size: 9px; wrap: word-wrap; overflow: clip; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        SurfaceButton {
                            width: root.compact-layout ? 88px : 96px;
                            height: 34px;
                            label: @tr("Choose folder");
                            clicked => { root.export-directory-requested(); }
                        }
                        SurfaceButton {
                            width: root.compact-layout ? 64px : 72px;
                            height: 34px;
                            label: @tr("Reset");
                            visible: root.export-default-directory != "";
                            clicked => { root.export-directory-reset-requested(); }
                        }
                    }
                }

                ToggleSettingRow {
                    title: @tr("Copy after capture");
                    detail: @tr("Immediately copy the unannotated image after selecting a region.");
                    checked: root.export-copy-after-capture;
                    toggled(value) => {
                        root.export-behavior-change-requested(
                            root.export-remember-last-directory,
                            value,
                            root.export-close-after-copy,
                            root.export-close-after-save
                        );
                    }
                }

                ToggleSettingRow {
                    title: @tr("End capture session after copy");
                    detail: @tr("Automatically close the capture overlay and return to the tray after copying the final edited image.");
                    checked: root.export-close-after-copy;
                    toggled(value) => {
                        root.export-behavior-change-requested(
                            root.export-remember-last-directory,
                            root.export-copy-after-capture,
                            value,
                            root.export-close-after-save
                        );
                    }
                }

                ToggleSettingRow {
                    title: @tr("End capture session after save");
                    detail: @tr("Automatically close after Quick Save or Save As succeeds; cancelling Save As keeps the session open.");
                    checked: root.export-close-after-save;
                    toggled(value) => {
                        root.export-behavior-change-requested(
                            root.export-remember-last-directory,
                            root.export-copy-after-capture,
                            root.export-close-after-copy,
                            value
                        );
                    }
                }

                Text {
                    text: @tr("Only PNG export is currently supported; the OCR text layer remains interactive and is not written into the image.");
                    color: Theme.text-faint;
                    font-size: 10px;
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }

        if root.page == "ocr": Rectangle {
            x: root.content-padding;
            y: root.content-top;
            width: parent.width - 2 * root.content-padding;
            height: parent.height - root.content-top - 16px;
            background: transparent;

            VerticalLayout {
                spacing: 14px;

                if !root.ocr-engine-enabled: Rectangle {
                    height: 64px;
                    border-radius: 11px;
                    background: Theme.accent-soft;
                    border-color: Theme.border;
                    border-width: 1px;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        Text { text: "ⓘ"; color: Theme.accent; font-size: 17px; vertical-alignment: center; }
                        Text { text: @tr("No model is enabled"); color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for model in root.ocr-models : Rectangle {
                        height: root.compact-layout ? 190px : 170px;
                        width: parent.width;
                        border-radius: 13px;
                        background: Theme.surface-raised;
                        border-color: model.active ? Theme.accent : Theme.border;
                        border-width: model.active ? 2px : 1px;

                        HorizontalLayout {
                            padding: root.compact-layout ? 12px : 16px;
                            spacing: root.compact-layout ? 12px : 16px;

                            Rectangle {
                                width: root.compact-layout ? 52px : 60px;
                                height: root.compact-layout ? 52px : 60px;
                                border-radius: 14px;
                                background: Theme.accent-soft;
                                Text {
                                    text: "OCR";
                                    color: Theme.accent;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                width: root.compact-layout ? 180px : 230px;
                                spacing: 5px;
                                Text { text: model.name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                                Text { text: @tr("Local · ") + model.languages; color: Theme.text-muted; font-size: 10px; overflow: elide; }
                                Text { text: model.version + " · " + model.size-label; color: Theme.text-faint; font-size: 9px; }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Text { text: model.active ? @tr("Enabled") : model.installed ? @tr("Downloaded · disabled") : @tr("Not downloaded"); color: model.active ? Theme.accent : model.installed ? Theme.success : Theme.text-faint; font-size: 10px; font-weight: 650; }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 7px;

                                if root.ocr-model-busy-id == model.id: Text {
                                    text: root.ocr-model-progress >= 0
                                        ? @tr("Downloading · ") + round(root.ocr-model-progress * 100) + "%"
                                        : @tr("Processing");
                                    color: Theme.text;
                                    font-size: 11px;
                                    font-weight: 650;
                                }

                                if root.ocr-model-busy-id == model.id: Rectangle {
                                    height: 7px;
                                    border-radius: 4px;
                                    background: Theme.border;
                                    Rectangle {
                                        width: root.ocr-model-progress >= 0
                                            ? parent.width * max(0, min(1, root.ocr-model-progress))
                                            : parent.width * 0.18;
                                        height: parent.height;
                                        border-radius: 4px;
                                        background: Theme.accent;
                                    }
                                }

                                if root.ocr-model-busy-id == model.id: Text {
                                    text: root.ocr-model-progress-label;
                                    color: Theme.text-faint;
                                    font-size: 9px;
                                    wrap: word-wrap;
                                    overflow: clip;
                                }

                                if root.ocr-model-error-id == model.id && root.ocr-model-error-text != "": Text {
                                    text: @tr("Download failed · ") + root.ocr-model-error-text;
                                    color: Theme.danger;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                    overflow: clip;
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    SurfaceButton {
                                        width: root.compact-layout ? 92px : 106px;
                                        height: 34px;
                                        label: root.ocr-model-busy-id == model.id
                                            ? root.ocr-model-cancellable ? @tr("Cancel download") : @tr("Processing…")
                                            : root.ocr-model-error-id == model.id ? @tr("Retry")
                                            : model.installed ? model.active ? @tr("Enabled") : @tr("Enable") : @tr("Download");
                                        primary: !model.active && root.ocr-model-busy-id == "";
                                        enabled: !root.ocr-running && !model.active
                                            && (root.ocr-model-busy-id == ""
                                                || (root.ocr-model-busy-id == model.id && root.ocr-model-cancellable));
                                        clicked => {
                                            if (root.ocr-model-busy-id == model.id && root.ocr-model-cancellable) {
                                                root.model-cancel-requested(model.id);
                                            } else if (model.installed) {
                                                root.model-enable-requested(model.id);
                                            } else {
                                                root.model-download-requested(model.id);
                                            }
                                        }
                                    }
                                    SurfaceButton {
                                        width: root.compact-layout ? 68px : 76px;
                                        height: 34px;
                                        label: @tr("Delete");
                                        danger: true;
                                        visible: model.installed && !model.active;
                                        enabled: !root.ocr-running && root.ocr-model-busy-id == "";
                                        clicked => { root.model-delete-requested(model.id); }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.page == "about": about-scroll := ScrollView {
            x: root.content-padding; y: root.content-top;
            width: parent.width - 2 * root.content-padding;
            height: parent.height - root.content-top - 16px;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;
            VerticalLayout {
                width: about-scroll.visible-width;
                spacing: 14px;
                Rectangle {
                    height: 132px; border-radius: 12px; background: Theme.surface-raised; border-color: Theme.border; border-width: 1px;
                    VerticalLayout {
                        padding: 16px; spacing: 6px;
                        Text { text: "Azusa Lens"; color: Theme.text; font-size: 18px; font-weight: 700; }
                        Text { text: @tr("Lightweight, local-first, extensible desktop capture and recognition tool"); color: Theme.text-muted; font-size: 11px; }
                        Text { text: @tr("Platform: ") + root.platform-name; color: Theme.text-faint; font-size: 10px; }
                        Text { text: @tr("OCR: ") + root.ocr-engine-name; color: Theme.text-faint; font-size: 10px; }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 58px;
        width: parent.width;
        height: 58px;
        background: Theme.surface-raised;
        border-color: Theme.border;
        border-width: 1px;

        HorizontalLayout {
            padding-left: root.narrow-layout ? 12px : 18px;
            padding-right: root.narrow-layout ? 12px : 18px;
            spacing: 10px;
            Text {
                text: root.has-capture ? @tr("Capture and annotations are retained") : @tr("Azusa Lens is running in the tray");
                color: Theme.text-faint;
                font-size: 10px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            SurfaceButton {
                width: 108px;
                height: 36px;
                label: @tr("Hide to tray");
                clicked => { root.close-requested(); }
            }
        }
    }
}
