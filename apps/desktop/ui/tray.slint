export component AppTray inherits SystemTrayIcon {
    in property <image> app-icon;
    callback quick-capture();
    callback show-main();
    callback quit();

    icon: root.app-icon;
    tooltip: @tr("Azusa Lens · Capture, OCR & Annotation");
    title: "Azusa Lens";
    clicked => { root.quick-capture(); }

    Menu {
        MenuItem { title: @tr("New region capture (PrtSc)"); activated => { root.quick-capture(); } }
        MenuItem { title: @tr("Settings"); activated => { root.show-main(); } }
        MenuSeparator { }
        MenuItem { title: @tr("Quit Azusa Lens"); activated => { root.quit(); } }
    }
}
