import { Theme, FeedbackToast } from "design-system.slint";
import { OcrOverlayItem, OcrModelItem } from "models.slint";
import { SettingsView } from "settings-view.slint";

export component AppWindow inherits Window {
    in property <string> platform-name: @tr("Unknown");
    in property <string> hotkey-name: @tr("Not configured");
    in property <string> hotkey-configured-name: "PrtSc";
    in property <string> hotkey-backend-name: @tr("Unknown backend");
    in property <bool> hotkey-portal-managed: false;
    in property <bool> hotkey-active: false;
    in property <bool> hotkey-registration-pending: false;
    in property <image> app-icon;
    in property <string> ocr-engine-name: @tr("Not configured");
    in-out property <string> status-text: @tr("Ready");
    in-out property <string> status-level: "info";
    in-out property <duration> status-duration: 3000ms;
    in-out property <string> language-mode: "system";
    in-out property <image> preview-image;
    in-out property <bool> has-capture: false;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> text-entry-visible: false;
    in-out property <string> pending-text: "";
    in-out property <string> active-tool: "rectangle";
    in-out property <int> active-color: 0;
    in-out property <float> active-stroke: 4;
    in-out property <float> capture-width: 0;
    in-out property <float> capture-height: 0;
    in-out property <float> zoom-factor: 1;
    in-out property <float> pan-x: 0;
    in-out property <float> pan-y: 0;
    in-out property <bool> has-selection: false;
    in-out property <float> object-selection-x: 0;
    in-out property <float> object-selection-y: 0;
    in-out property <float> object-selection-width: 0;
    in-out property <float> object-selection-height: 0;
    in-out property <[OcrOverlayItem]> ocr-items;
    in-out property <string> ocr-text: "";
    in-out property <int> ocr-line-count: 0;
    in-out property <bool> ocr-overlay-visible: false;
    in-out property <bool> ocr-running: false;
    in-out property <int> ocr-epoch: 0;
    in-out property <int> ocr-selection-anchor: -1;
    in-out property <int> ocr-selection-focus: -1;
    in-out property <int> ocr-hover-index: -1;
    in-out property <[OcrModelItem]> ocr-models;
    in-out property <string> ocr-text-model-id: "";
    in-out property <string> ocr-document-model-id: "";
    in-out property <string> ocr-table-model-id: "";
    in-out property <string> ocr-figure-model-id: "";
    in-out property <string> ocr-model-busy-id: "";
    in-out property <float> ocr-model-progress: -1;
    in-out property <string> ocr-model-progress-label: "";
    in-out property <bool> ocr-model-cancellable: false;
    in-out property <string> ocr-model-error-id: "";
    in-out property <string> ocr-model-error-text: "";
    in-out property <bool> shell-context-menu-supported: false;
    in-out property <bool> shell-context-menu-registered: false;
    in-out property <string> shell-context-menu-detail: "";
    in-out property <string> export-default-directory: "";
    in-out property <bool> export-remember-last-directory: true;
    in-out property <bool> export-copy-after-capture: true;
    in-out property <bool> export-close-after-copy: true;
    in-out property <bool> export-close-after-save: true;

    in-out property <string> settings-page: "general";

    callback capture-requested();
    callback copy-requested();
    callback save-requested();
    callback save-as-requested();
    callback ocr-requested();
    callback copy-ocr-requested();
    callback ocr-hit-test(float, float) -> int;
    callback copy-ocr-selection-requested(int, int);
    callback ocr-selection-to-text-requested(int, int);
    callback ocr-model-download-requested(string);
    callback ocr-model-cancel-requested(string);
    callback ocr-task-model-selected(string, string);
    callback ocr-model-delete-requested(string);
    callback shell-context-menu-register-requested();
    callback shell-context-menu-remove-requested();
    callback hotkey-register-requested();
    callback hotkey-binding-requested(bool, bool, bool, bool, string);
    callback hotkey-reset-requested();
    callback export-directory-requested();
    callback export-directory-reset-requested();
    callback export-behavior-change-requested(bool, bool, bool, bool);
    callback language-change-requested(string);
    callback tool-selected(string);
    callback color-selected(int);
    callback stroke-selected(float);
    callback editor-pointer-down(float, float, float, float);
    callback editor-pointer-moved(float, float, float, float);
    callback editor-pointer-up(float, float, float, float);
    callback text-submit(string);
    callback nudge-selection-requested(float, float);
    callback undo-requested();
    callback redo-requested();
    callback delete-selection-requested();
    callback clear-annotations-requested();

    title: @tr("Azusa Lens · Settings");
    icon: root.app-icon;
    preferred-width: 1080px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.window;
    settings := SettingsView {
        visible: true;
        width: parent.width;
        height: parent.height;
        page <=> root.settings-page;
        platform-name: root.platform-name;
        hotkey-name: root.hotkey-name;
        hotkey-configured-name: root.hotkey-configured-name;
        hotkey-backend-name: root.hotkey-backend-name;
        hotkey-portal-managed: root.hotkey-portal-managed;
        hotkey-active: root.hotkey-active;
        hotkey-registration-pending: root.hotkey-registration-pending;
        ocr-engine-name: root.ocr-engine-name;
        ocr-models: root.ocr-models;
        ocr-text-model-id: root.ocr-text-model-id;
        ocr-document-model-id: root.ocr-document-model-id;
        ocr-table-model-id: root.ocr-table-model-id;
        ocr-figure-model-id: root.ocr-figure-model-id;
        ocr-running: root.ocr-running;
        ocr-model-busy-id: root.ocr-model-busy-id;
        ocr-model-progress: root.ocr-model-progress;
        ocr-model-progress-label: root.ocr-model-progress-label;
        ocr-model-cancellable: root.ocr-model-cancellable;
        ocr-model-error-id: root.ocr-model-error-id;
        ocr-model-error-text: root.ocr-model-error-text;
        shell-context-menu-supported: root.shell-context-menu-supported;
        shell-context-menu-registered: root.shell-context-menu-registered;
        shell-context-menu-detail: root.shell-context-menu-detail;
        has-capture: root.has-capture;
        export-default-directory: root.export-default-directory;
        export-remember-last-directory: root.export-remember-last-directory;
        export-copy-after-capture: root.export-copy-after-capture;
        export-close-after-copy: root.export-close-after-copy;
        export-close-after-save: root.export-close-after-save;
        language-mode: root.language-mode;

        hotkey-register-requested => { root.hotkey-register-requested(); }
        hotkey-binding-requested(control, alt, shift, meta, key-text) => {
            root.hotkey-binding-requested(control, alt, shift, meta, key-text);
        }
        hotkey-reset-requested => { root.hotkey-reset-requested(); }
        export-directory-requested => { root.export-directory-requested(); }
        export-directory-reset-requested => { root.export-directory-reset-requested(); }
        language-change-requested(mode) => { root.language-change-requested(mode); }
        export-behavior-change-requested(remember-last, copy-after-capture, close-after-copy, close-after-save) => {
            root.export-behavior-change-requested(
                remember-last,
                copy-after-capture,
                close-after-copy,
                close-after-save
            );
        }
        model-download-requested(id) => { root.ocr-model-download-requested(id); }
        model-cancel-requested(id) => { root.ocr-model-cancel-requested(id); }
        task-model-selected(task, id) => { root.ocr-task-model-selected(task, id); }
        model-delete-requested(id) => { root.ocr-model-delete-requested(id); }
        shell-context-menu-register-requested => { root.shell-context-menu-register-requested(); }
        shell-context-menu-remove-requested => { root.shell-context-menu-remove-requested(); }
    }

    FeedbackToast {
        x: max(12px, (root.width - self.width) / 2);
        y: root.height - 60px;
        width: min(520px, root.width - 24px);
        text <=> root.status-text;
        level: root.status-level;
        duration: root.status-duration;
    }
}
