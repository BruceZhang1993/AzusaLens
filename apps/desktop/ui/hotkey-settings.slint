import { Theme, SurfaceButton } from "design-system.slint";

export component HotkeySettings inherits Rectangle {
    in property <string> configured-name: "PrtSc";
    in property <string> effective-name: "PrtSc";
    in property <string> backend-name: @tr("Unknown backend");
    in property <bool> portal-managed: false;
    in property <bool> active: false;
    in property <bool> registration-pending: false;

    callback register-requested();
    callback binding-requested(bool, bool, bool, bool, string);
    callback reset-requested();

    private property <bool> recording: false;

    background: transparent;

    recorder := FocusScope {
        enabled: root.recording && !root.registration-pending;
        key-pressed(event) => {
            if (!root.recording) {
                reject
            } else if (event.text == Key.Escape) {
                root.recording = false;
                accept
            } else if (
                event.text == Key.Shift || event.text == Key.ShiftR
                || event.text == Key.Control || event.text == Key.ControlR
                || event.text == Key.Alt || event.text == Key.AltGr
                || event.text == Key.Meta || event.text == Key.MetaR
            ) {
                accept
            } else {
                if (!event.repeat) {
                    root.recording = false;
                    root.binding-requested(
                        event.modifiers.control,
                        event.modifiers.alt,
                        event.modifiers.shift,
                        event.modifiers.meta,
                        event.text
                    );
                }
                accept
            }
        }
    }

    VerticalLayout {
        spacing: 14px;

        Rectangle {
            height: 112px;
            border-radius: 12px;
            background: Theme.surface-raised;
            border-color: Theme.border;
            border-width: 1px;

            HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: Theme.accent-soft;
                    Text {
                        text: "⌨";
                        color: Theme.accent;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    width: 230px;
                    spacing: 4px;
                    Text { text: @tr("Region capture"); color: Theme.text; font-size: 13px; font-weight: 650; }
                    Text { text: @tr("Global shortcut"); color: Theme.text-faint; font-size: 10px; }
                    Text {
                        text: root.backend-name;
                        color: Theme.text-faint;
                        font-size: 9px;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                VerticalLayout {
                    width: 290px;
                    spacing: 5px;
                    Text { text: @tr("Configured"); color: Theme.text-faint; font-size: 9px; }
                    Rectangle {
                        height: 40px;
                        border-radius: 9px;
                        background: Theme.surface;
                        border-color: root.recording ? Theme.accent : Theme.border;
                        border-width: root.recording ? 2px : 1px;
                        Text {
                            text: root.recording ? @tr("Press a new shortcut…") : root.configured-name;
                            color: root.recording ? Theme.accent : Theme.text;
                            font-size: 12px;
                            font-weight: root.recording ? 650 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 78px;
            border-radius: 12px;
            background: Theme.surface-raised;
            border-color: Theme.border;
            border-width: 1px;
            HorizontalLayout {
                padding: 14px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.active ? @tr("Active") : root.registration-pending ? @tr("Registering") : @tr("Not registered");
                        color: root.active ? Theme.success : root.registration-pending ? Theme.accent : Theme.danger;
                        font-size: 11px;
                        font-weight: 650;
                    }
                    Text {
                        text: root.active ? root.effective-name
                            : root.registration-pending ? @tr("Waiting for the system shortcut service…")
                            : @tr("Retry the current binding or record a new shortcut.");
                        color: Theme.text-muted;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SurfaceButton {
                    width: 108px;
                    height: 34px;
                    label: root.recording ? @tr("Recording…") : @tr("Change shortcut");
                    primary: root.recording;
                    enabled: !root.registration-pending;
                    clicked => {
                        root.recording = true;
                        recorder.focus();
                    }
                }
                SurfaceButton {
                    width: 88px;
                    height: 34px;
                    label: @tr("Restore default");
                    enabled: !root.registration-pending && !root.recording;
                    clicked => {
                        root.recording = false;
                        root.reset-requested();
                    }
                }
                SurfaceButton {
                    width: 72px;
                    height: 34px;
                    label: @tr("Retry");
                    visible: !root.active && !root.registration-pending;
                    enabled: !root.recording;
                    clicked => { root.register-requested(); }
                }
            }
        }

        Rectangle {
            height: root.portal-managed ? 100px : 78px;
            border-radius: 12px;
            background: Theme.surface-raised;
            border-color: Theme.border;
            border-width: 1px;
            VerticalLayout {
                padding: 14px;
                spacing: 5px;
                Text {
                    text: root.portal-managed ? @tr("Managed by Wayland") : @tr("Shortcut rules");
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 650;
                }
                Text {
                    text: root.portal-managed
                        ? @tr("Azusa Lens submits the recorded shortcut as the preferred binding to the XDG GlobalShortcuts Portal. The desktop may ask for confirmation or assign a different key; “Active” always shows the binding returned by the system.")
                        : @tr("Letters, digits, and navigation keys require at least Ctrl, Alt, Shift, or Super. PrtSc and F1–F24 can be used as global shortcuts without modifiers.");
                    color: Theme.text-muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                if root.recording: Text {
                    text: @tr("Press Esc to cancel recording.");
                    color: Theme.accent;
                    font-size: 9px;
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
