import { Theme, SurfaceButton } from "design-system.slint";

export component HotkeySettings inherits Rectangle {
    in property <string> configured-name: "PrtSc";
    in property <string> effective-name: "PrtSc";
    in property <string> backend-name: "Unknown backend";
    in property <bool> portal-managed: false;
    in property <bool> active: false;
    in property <bool> registration-pending: false;

    callback register-requested();
    callback binding-requested(bool, bool, bool, bool, string);
    callback reset-requested();

    private property <bool> recording: false;

    background: transparent;

    recorder := FocusScope {
        enabled: root.recording && !root.registration-pending;
        key-pressed(event) => {
            if (!root.recording) {
                reject
            } else if (event.text == Key.Escape) {
                root.recording = false;
                accept
            } else if (
                event.text == Key.Shift || event.text == Key.ShiftR
                || event.text == Key.Control || event.text == Key.ControlR
                || event.text == Key.Alt || event.text == Key.AltGr
                || event.text == Key.Meta || event.text == Key.MetaR
            ) {
                accept
            } else {
                if (!event.repeat) {
                    root.recording = false;
                    root.binding-requested(
                        event.modifiers.control,
                        event.modifiers.alt,
                        event.modifiers.shift,
                        event.modifiers.meta,
                        event.text
                    );
                }
                accept
            }
        }
    }

    VerticalLayout {
        spacing: 14px;

        Rectangle {
            height: 112px;
            border-radius: 12px;
            background: Theme.surface-raised;
            border-color: Theme.border;
            border-width: 1px;

            HorizontalLayout {
                padding: 14px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: Theme.accent-soft;
                    Text {
                        text: "⌨";
                        color: Theme.accent;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    width: 230px;
                    spacing: 4px;
                    Text { text: "区域截图"; color: Theme.text; font-size: 13px; font-weight: 650; }
                    Text { text: "全局快捷键"; color: Theme.text-faint; font-size: 10px; }
                    Text {
                        text: root.backend-name;
                        color: Theme.text-faint;
                        font-size: 9px;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                VerticalLayout {
                    width: 290px;
                    spacing: 5px;
                    Text { text: "已配置"; color: Theme.text-faint; font-size: 9px; }
                    Rectangle {
                        height: 40px;
                        border-radius: 9px;
                        background: Theme.surface;
                        border-color: root.recording ? Theme.accent : Theme.border;
                        border-width: root.recording ? 2px : 1px;
                        Text {
                            text: root.recording ? "请按下新的快捷键…" : root.configured-name;
                            color: root.recording ? Theme.accent : Theme.text;
                            font-size: 12px;
                            font-weight: root.recording ? 650 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 78px;
            border-radius: 12px;
            background: Theme.surface-raised;
            border-color: Theme.border;
            border-width: 1px;
            HorizontalLayout {
                padding: 14px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.active ? "当前生效" : root.registration-pending ? "正在注册" : "当前未注册";
                        color: root.active ? Theme.success : root.registration-pending ? Theme.accent : Theme.danger;
                        font-size: 11px;
                        font-weight: 650;
                    }
                    Text {
                        text: root.active ? root.effective-name
                            : root.registration-pending ? "正在等待系统快捷键服务响应…"
                            : "可重试当前配置，或录制新的快捷键。";
                        color: Theme.text-muted;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SurfaceButton {
                    width: 108px;
                    height: 34px;
                    label: root.recording ? "按键中…" : "修改快捷键";
                    primary: root.recording;
                    enabled: !root.registration-pending;
                    clicked => {
                        root.recording = true;
                        recorder.focus();
                    }
                }
                SurfaceButton {
                    width: 88px;
                    height: 34px;
                    label: "恢复默认";
                    enabled: !root.registration-pending && !root.recording;
                    clicked => {
                        root.recording = false;
                        root.reset-requested();
                    }
                }
                SurfaceButton {
                    width: 72px;
                    height: 34px;
                    label: "重试";
                    visible: !root.active && !root.registration-pending;
                    enabled: !root.recording;
                    clicked => { root.register-requested(); }
                }
            }
        }

        Rectangle {
            height: root.portal-managed ? 100px : 78px;
            border-radius: 12px;
            background: Theme.surface-raised;
            border-color: Theme.border;
            border-width: 1px;
            VerticalLayout {
                padding: 14px;
                spacing: 5px;
                Text {
                    text: root.portal-managed ? "Wayland 系统管理" : "快捷键规则";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 650;
                }
                Text {
                    text: root.portal-managed
                        ? "Azusa Lens 会把录制的组合键作为首选值提交给 XDG GlobalShortcuts Portal；桌面环境可以要求确认或分配不同按键，上方“当前生效”始终显示系统返回的实际绑定。"
                        : "普通字母、数字和导航键需要至少包含 Ctrl、Alt、Shift 或 Super；PrtSc 与 F1–F24 可以单独作为全局快捷键。";
                    color: Theme.text-muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                if root.recording: Text {
                    text: "按 Esc 取消录制。";
                    color: Theme.accent;
                    font-size: 9px;
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
