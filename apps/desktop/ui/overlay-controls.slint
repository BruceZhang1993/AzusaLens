import { Theme, OverlayIconButton, ColorChip, StrokeChip } from "design-system.slint";

export global OcrActionState {
    in-out property <string> task: "text";
}

component Panel inherits Rectangle {
    background: Theme.overlay-panel;
    border-color: Theme.overlay-panel-border;
    border-width: 1px;
    border-radius: 10px;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #00000024;
}

component OcrMenuButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <length> viewport-width;
    in property <length> viewport-height;
    callback clicked();

    width: 20px;
    height: 32px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.overlay-hover : transparent;
    accessible-role: button;
    accessible-label: @tr("More OCR options");
    accessible-enabled: root.enabled;
    Image {
        x: 4px;
        y: 10px;
        width: 12px;
        height: 12px;
        source: @image-url("icons/chevron-down.svg");
        colorize: root.selected ? Theme.accent : Theme.overlay-text;
        accessible-role: none;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component OcrMenuItem inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    callback clicked();

    height: 34px;
    border-radius: 7px;
    background: touch.has-hover ? Theme.overlay-hover : transparent;
    VerticalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 1px;
        Text {
            text: root.title;
            color: Theme.overlay-text;
            font-size: 10px;
            font-weight: 650;
        }
        Text {
            text: root.detail;
            color: Theme.overlay-text-faint;
            font-size: 8px;
            overflow: elide;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component OverlayControls inherits Rectangle {
    in property <float> canvas-x;
    in property <float> canvas-y;
    in property <float> canvas-width;
    in property <float> canvas-height;
    in property <string> active-tool;
    in property <int> active-color;
    in property <float> active-stroke;
    in property <bool> has-selection;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> ocr-visible;
    in property <bool> ocr-running;
    in property <bool> ocr-busy;
    in property <int> ocr-line-count;
    in property <bool> ocr-has-selection;
    in-out property <bool> more-visible: false;
    in-out property <bool> properties-visible: false;
    private property <bool> ocr-types-visible: false;
    callback tool-selected(string);
    callback color-selected(int);
    callback stroke-selected(float);
    callback undo();
    callback redo();
    callback ocr();
    callback select-all();
    callback copy-text();
    callback save();
    callback save-as();
    callback copy-image();
    callback close();
    callback delete-selection();
    callback clear();
    private property <bool> compact: root.width < 700px || root.canvas-width < 700;
    private property <length> bar-width: root.ocr-visible
        ? (root.compact ? 250px : 300px)
        : (root.compact ? 270px : 680px);
    private property <length> bar-x: max(8px, min(root.width - root.bar-width - 8px, (root.canvas-x + root.canvas-width) * 1px - root.bar-width));
    private property <length> bar-y: root.canvas-height * 1px >= root.height - 2px ? root.height - 52px
        : (root.canvas-y + root.canvas-height) * 1px + 52px <= root.height ? (root.canvas-y + root.canvas-height) * 1px + 8px
        : root.canvas-y * 1px >= 52px ? root.canvas-y * 1px - 52px : max(8px, root.height - 52px);
    private property <length> popup-width: min(288px, root.width - 16px);
    private property <length> popup-x: max(8px, min(root.width - root.popup-width - 8px, root.bar-x));
    private property <length> popup-height: root.more-visible ? (root.compact ? 96px : 56px) : 88px;
    private property <length> popup-y: root.bar-y >= root.popup-height + 16px ? root.bar-y - root.popup-height - 8px : min(root.height - root.popup-height - 8px, root.bar-y + 52px);
    private property <length> ocr-popup-width: min(236px, root.width - 16px);
    private property <length> ocr-popup-height: 122px;
    private property <length> ocr-popup-x: max(8px, min(root.width - root.ocr-popup-width - 8px, root.bar-x + (root.compact ? 62px : 350px)));
    private property <length> ocr-popup-y: root.bar-y >= root.ocr-popup-height + 16px ? root.bar-y - root.ocr-popup-height - 8px : min(root.height - root.ocr-popup-height - 8px, root.bar-y + 52px);
    changed ocr-visible => { root.more-visible = false; root.properties-visible = false; root.ocr-types-visible = false; }
    function choose(tool: string) {
        root.more-visible = false;
        root.properties-visible = false;
        root.ocr-types-visible = false;
        root.tool-selected(tool);
    }
    function recognize(task: string) {
        root.ocr-types-visible = false;
        OcrActionState.task = task;
        root.ocr();
    }

    // Panels intercept their empty space; the canvas remains available for drawing.
    bar := Panel {
        x: root.bar-x; y: root.bar-y; width: root.bar-width; height: 44px;
        TouchArea { }
        HorizontalLayout {
            padding: 6px; spacing: 4px;

            // Left side: annotation, OCR, and edit operations.
            if !root.ocr-visible && !root.compact: HorizontalLayout {
                spacing: 4px;
                OverlayIconButton { icon: @image-url("icons/mouse-pointer-2.svg"); label: @tr("Select annotation"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "select"; clicked => { root.choose("select"); } }
                OverlayIconButton { icon: @image-url("icons/square.svg"); label: @tr("Rectangle"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "rectangle"; clicked => { root.choose("rectangle"); } }
                OverlayIconButton { icon: @image-url("icons/arrow-up-right.svg"); label: @tr("Arrow"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "arrow"; clicked => { root.choose("arrow"); } }
                OverlayIconButton { icon: @image-url("icons/pencil.svg"); label: @tr("Pen"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "pen"; clicked => { root.choose("pen"); } }
                OverlayIconButton { icon: @image-url("icons/type.svg"); label: @tr("Text"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "text"; clicked => { root.choose("text"); } }
                OverlayIconButton { icon: @image-url("icons/grid-2x2.svg"); label: @tr("Mosaic"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "mosaic"; clicked => { root.choose("mosaic"); } }
                OverlayIconButton { icon: @image-url("icons/circle.svg"); label: @tr("Ellipse"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "ellipse"; clicked => { root.choose("ellipse"); } }
                OverlayIconButton { icon: @image-url("icons/minus.svg"); label: @tr("Line"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "line"; clicked => { root.choose("line"); } }
            }

            if !root.ocr-visible: HorizontalLayout {
                spacing: 4px;
                OverlayIconButton { icon: @image-url("icons/ellipsis.svg"); label: @tr("More tools"); viewport-width: root.width; viewport-height: root.height; selected: root.more-visible; clicked => { root.more-visible = !root.more-visible; root.properties-visible = false; root.ocr-types-visible = false; } }
                OverlayIconButton { icon: @image-url("icons/palette.svg"); label: @tr("Color and stroke"); viewport-width: root.width; viewport-height: root.height; selected: root.properties-visible; clicked => { root.properties-visible = !root.properties-visible; root.more-visible = false; root.ocr-types-visible = false; } }
                HorizontalLayout {
                    spacing: 0px;
                    OverlayIconButton {
                        icon: @image-url("icons/scan-text.svg");
                        label: @tr("Recognize text");
                        viewport-width: root.width;
                        viewport-height: root.height;
                        busy: root.ocr-running;
                        enabled: !root.ocr-running && !root.ocr-busy;
                        disabled-reason: root.ocr-running ? @tr("Recognizing text…") : @tr("OCR model is busy");
                        clicked => { root.recognize("text"); }
                    }
                    OcrMenuButton {
                        viewport-width: root.width;
                        viewport-height: root.height;
                        enabled: !root.ocr-running && !root.ocr-busy;
                        selected: root.ocr-types-visible;
                        clicked => {
                            root.ocr-types-visible = !root.ocr-types-visible;
                            root.more-visible = false;
                            root.properties-visible = false;
                        }
                    }
                }
            }

            if !root.ocr-visible && !root.compact: HorizontalLayout {
                spacing: 4px;
                OverlayIconButton { icon: @image-url("icons/undo-2.svg"); label: @tr("Undo · Ctrl+Z"); viewport-width: root.width; viewport-height: root.height; enabled: root.can-undo; disabled-reason: @tr("Nothing to undo"); clicked => { root.undo(); } }
                OverlayIconButton { icon: @image-url("icons/redo-2.svg"); label: @tr("Redo · Ctrl+Shift+Z"); viewport-width: root.width; viewport-height: root.height; enabled: root.can-redo; disabled-reason: @tr("Nothing to redo"); clicked => { root.redo(); } }
            }

            if root.ocr-visible: HorizontalLayout {
                spacing: 4px;
                OverlayIconButton { icon: @image-url("icons/arrow-left.svg"); label: @tr("Back to annotations"); viewport-width: root.width; viewport-height: root.height; clicked => { root.ocr(); } }
                OverlayIconButton { icon: @image-url("icons/check-check.svg"); label: @tr("Select all text · Ctrl+A"); viewport-width: root.width; viewport-height: root.height; enabled: root.ocr-line-count > 0; disabled-reason: @tr("No text available"); clicked => { root.select-all(); } }
                OverlayIconButton { icon: @image-url("icons/text-select.svg"); label: @tr("Copy selected text · Ctrl+C"); viewport-width: root.width; viewport-height: root.height; enabled: root.ocr-has-selection; disabled-reason: @tr("Select text first"); clicked => { root.copy-text(); } }
            }

            Rectangle { horizontal-stretch: 1; }
            Rectangle { width: 1px; background: Theme.overlay-divider; }

            // Right side: image completion and export operations.
            HorizontalLayout {
                spacing: 4px;
                OverlayIconButton { icon: @image-url("icons/copy.svg"); label: @tr("Copy image"); viewport-width: root.width; viewport-height: root.height; primary: true; clicked => { root.copy-image(); } }
                OverlayIconButton { icon: @image-url("icons/save.svg"); label: @tr("Save image · Ctrl+S"); viewport-width: root.width; viewport-height: root.height; clicked => { root.save(); } }
                if !root.compact: OverlayIconButton { icon: @image-url("icons/save.svg"); label: @tr("Save As… · Ctrl+Shift+S"); viewport-width: root.width; viewport-height: root.height; clicked => { root.save-as(); } }
                OverlayIconButton { icon: @image-url("icons/x.svg"); label: @tr("End capture · Esc"); viewport-width: root.width; viewport-height: root.height; clicked => { root.close(); } }
            }
        }
    }

    if root.ocr-types-visible && !root.ocr-visible: Panel {
        x: root.ocr-popup-x;
        y: root.ocr-popup-y;
        width: root.ocr-popup-width;
        height: root.ocr-popup-height;
        TouchArea { }
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            OcrMenuItem {
                title: @tr("Document parsing");
                detail: @tr("Save structured Markdown");
                clicked => { root.recognize("document"); }
            }
            OcrMenuItem {
                title: @tr("Table recognition");
                detail: @tr("Preserve rows, columns and cells");
                clicked => { root.recognize("table"); }
            }
            OcrMenuItem {
                title: @tr("Figure parsing");
                detail: @tr("Understand charts and diagrams");
                clicked => { root.recognize("figure"); }
            }
        }
    }

    if root.more-visible: Panel {
        x: root.popup-x; y: root.popup-y; width: root.popup-width; height: root.popup-height;
        TouchArea { }
        VerticalLayout {
            padding: 8px; spacing: 8px;
            if root.compact: HorizontalLayout {
                spacing: 4px;
                OverlayIconButton { icon: @image-url("icons/mouse-pointer-2.svg"); label: @tr("Select annotation"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "select"; clicked => { root.choose("select"); } }
                OverlayIconButton { icon: @image-url("icons/square.svg"); label: @tr("Rectangle"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "rectangle"; clicked => { root.choose("rectangle"); } }
                OverlayIconButton { icon: @image-url("icons/arrow-up-right.svg"); label: @tr("Arrow"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "arrow"; clicked => { root.choose("arrow"); } }
                OverlayIconButton { icon: @image-url("icons/pencil.svg"); label: @tr("Pen"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "pen"; clicked => { root.choose("pen"); } }
                OverlayIconButton { icon: @image-url("icons/type.svg"); label: @tr("Text"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "text"; clicked => { root.choose("text"); } }
                OverlayIconButton { icon: @image-url("icons/grid-2x2.svg"); label: @tr("Mosaic"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "mosaic"; clicked => { root.choose("mosaic"); } }
            }
            HorizontalLayout {
                spacing: 4px;
                if root.compact: OverlayIconButton { icon: @image-url("icons/circle.svg"); label: @tr("Ellipse"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "ellipse"; clicked => { root.choose("ellipse"); } }
                if root.compact: OverlayIconButton { icon: @image-url("icons/minus.svg"); label: @tr("Line"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "line"; clicked => { root.choose("line"); } }
                OverlayIconButton { icon: @image-url("icons/list-ordered.svg"); label: @tr("Number"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "number"; clicked => { root.choose("number"); } }
                OverlayIconButton { icon: @image-url("icons/blend.svg"); label: @tr("Blur"); viewport-width: root.width; viewport-height: root.height; selected: root.active-tool == "blur"; clicked => { root.choose("blur"); } }
                OverlayIconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Clear annotations"); viewport-width: root.width; viewport-height: root.height; enabled: root.can-undo; disabled-reason: @tr("No annotations to clear"); clicked => { root.clear(); root.more-visible = false; } }
            }
        }
    }

    if root.properties-visible: Panel {
        x: root.popup-x; y: root.popup-y; width: root.popup-width; height: root.popup-height;
        TouchArea { }
        VerticalLayout {
            padding: 10px; spacing: 10px;
            HorizontalLayout { spacing: 8px;
                ColorChip { swatch-color: #ef4444; selected: root.active-color == 0; chosen => { root.color-selected(0); } }
                ColorChip { swatch-color: #f97316; selected: root.active-color == 1; chosen => { root.color-selected(1); } }
                ColorChip { swatch-color: #eab308; selected: root.active-color == 2; chosen => { root.color-selected(2); } }
                ColorChip { swatch-color: #22c55e; selected: root.active-color == 3; chosen => { root.color-selected(3); } }
                ColorChip { swatch-color: #3b82f6; selected: root.active-color == 4; chosen => { root.color-selected(4); } }
                ColorChip { swatch-color: #8b5cf6; selected: root.active-color == 5; chosen => { root.color-selected(5); } }
                ColorChip { swatch-color: white; selected: root.active-color == 6; chosen => { root.color-selected(6); } }
                ColorChip { swatch-color: #111827; selected: root.active-color == 7; chosen => { root.color-selected(7); } }
            }
            HorizontalLayout { spacing: 6px;
                StrokeChip { label: "2 px"; selected: root.active-stroke == 2; chosen => { root.stroke-selected(2); } }
                StrokeChip { label: "4 px"; selected: root.active-stroke == 4; chosen => { root.stroke-selected(4); } }
                StrokeChip { label: "8 px"; selected: root.active-stroke == 8; chosen => { root.stroke-selected(8); } }
                StrokeChip { label: "12 px"; selected: root.active-stroke == 12; chosen => { root.stroke-selected(12); } }
            }
        }
    }
}
