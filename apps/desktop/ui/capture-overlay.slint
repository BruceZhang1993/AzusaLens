export component RegionOverlay inherits Window {
    in-out property <image> screenshot;

    private property <float> start-x: 0;
    private property <float> start-y: 0;
    private property <float> end-x: 0;
    private property <float> end-y: 0;
    private property <float> selection-x: min(root.start-x, root.end-x);
    private property <float> selection-y: min(root.start-y, root.end-y);
    private property <float> selection-width: abs(root.end-x - root.start-x);
    private property <float> selection-height: abs(root.end-y - root.start-y);
    private property <bool> has-selection: root.selection-width >= 2 && root.selection-height >= 2;

    callback selection-confirmed(float, float, float, float);
    callback cancelled();

    title: "Azusa Lens Region Capture";
    full-screen: true;
    always-on-top: true;
    background: black;
    forward-focus: key-handler;

    Image {
        source: root.screenshot;
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }

    if !root.has-selection: Rectangle {
        width: parent.width; height: parent.height; background: #07101166;
    }
    if root.has-selection: Rectangle {
        x: 0px; y: 0px; width: parent.width;
        height: root.selection-y * 1px; background: #0710118c;
    }
    if root.has-selection: Rectangle {
        x: 0px; y: (root.selection-y + root.selection-height) * 1px;
        width: parent.width; height: max(0px, parent.height - self.y); background: #0710118c;
    }
    if root.has-selection: Rectangle {
        x: 0px; y: root.selection-y * 1px;
        width: root.selection-x * 1px; height: root.selection-height * 1px; background: #0710118c;
    }
    if root.has-selection: Rectangle {
        x: (root.selection-x + root.selection-width) * 1px; y: root.selection-y * 1px;
        width: max(0px, parent.width - self.x); height: root.selection-height * 1px; background: #0710118c;
    }

    if root.has-selection: Rectangle {
        x: root.selection-x * 1px; y: root.selection-y * 1px;
        width: root.selection-width * 1px; height: root.selection-height * 1px;
        background: transparent; border-color: #20c7b7; border-width: 2px;
        Rectangle { x: -5px; y: -5px; width: 10px; height: 10px; background: #f4fffd; border-color: #20c7b7; border-width: 2px; }
        Rectangle { x: parent.width - 5px; y: -5px; width: 10px; height: 10px; background: #f4fffd; border-color: #20c7b7; border-width: 2px; }
        Rectangle { x: -5px; y: parent.height - 5px; width: 10px; height: 10px; background: #f4fffd; border-color: #20c7b7; border-width: 2px; }
        Rectangle { x: parent.width - 5px; y: parent.height - 5px; width: 10px; height: 10px; background: #f4fffd; border-color: #20c7b7; border-width: 2px; }
    }

    if root.has-selection: Rectangle {
        x: max(8px, root.selection-x * 1px + 8px);
        y: max(8px, root.selection-y * 1px - 30px);
        width: 92px; height: 24px; border-radius: 6px; background: #151b1fe8;
        Text {
            text: round(root.selection-width) + " × " + round(root.selection-height);
            color: #d8fffa; font-size: 10px;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    capture-area := TouchArea {
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-x = self.mouse-x / 1px;
                root.start-y = self.mouse-y / 1px;
                root.end-x = root.start-x;
                root.end-y = root.start-y;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.end-x = self.mouse-x / 1px;
                root.end-y = self.mouse-y / 1px;
                if (root.has-selection) {
                    root.selection-confirmed(root.selection-x, root.selection-y, root.selection-width, root.selection-height);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.end-x = self.mouse-x / 1px;
                root.end-y = self.mouse-y / 1px;
            }
        }
    }

    Rectangle {
        x: (parent.width - 454px) / 2;
        y: 22px; width: 454px; height: 46px;
        border-radius: 12px; background: #151b1feb; border-color: #ffffff1a; border-width: 1px;
        HorizontalLayout {
            padding-left: 14px; padding-right: 10px; spacing: 12px;
            Rectangle {
                width: 18px; background: transparent;
                Text { text: "◇"; color: #20c7b7; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: "Azusa Lens"; color: #f5f8f8; font-size: 12px; font-weight: 650; vertical-alignment: center; }
            Rectangle { width: 1px; height: 22px; background: #ffffff24; }
            Rectangle {
                horizontal-stretch: 1; background: transparent;
                Text { text: "Drag to select a region"; color: #d7dddf; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { width: 1px; height: 22px; background: #ffffff24; }
            Rectangle {
                width: 88px; border-radius: 8px; background: full-touch.has-hover ? #293236 : transparent;
                Text { text: "Full screen"; color: #eef5f4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                full-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.selection-confirmed(0, 0, root.width / 1px, root.height / 1px); }
                }
            }
            Text { text: "Esc"; color: #9da7aa; font-size: 10px; vertical-alignment: center; }
        }
    }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancelled(); accept } else { reject }
        }
    }
}
