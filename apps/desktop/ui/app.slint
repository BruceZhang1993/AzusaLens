import { Button, ListView } from "std-widgets.slint";

component ToolChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback chosen();

    width: 78px;
    height: 34px;
    border-radius: 10px;
    background: root.selected ? #7c5ce6 : #1a1e28;
    border-color: root.selected ? #a996f2 : #303747;
    border-width: 1px;

    Text {
        text: root.label;
        color: root.selected ? white : #c3cad8;
        font-size: 12px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

component ColorChip inherits Rectangle {
    in property <color> swatch-color;
    in property <bool> selected: false;
    callback chosen();

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: root.swatch-color;
    border-color: root.selected ? white : #525b6d;
    border-width: root.selected ? 3px : 1px;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

component StrokeChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback chosen();

    width: 36px;
    height: 28px;
    border-radius: 9px;
    background: root.selected ? #2e2750 : #171b24;
    border-color: root.selected ? #8f76ef : #303747;
    border-width: 1px;
    Text {
        text: root.label;
        color: root.selected ? #dcd3ff : #aab3c3;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

component SelectionHandle inherits Rectangle {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: white;
    border-color: #7c5ce6;
    border-width: 2px;
}

export struct OcrOverlayItem {
    x: float,
    y: float,
    width: float,
    height: float,
    confidence: float,
    text: string,
    p0-x: float,
    p0-y: float,
    p1-x: float,
    p1-y: float,
    p2-x: float,
    p2-y: float,
    p3-x: float,
    p3-y: float,
}

export struct OcrModelItem {
    id: string,
    name: string,
    version: string,
    languages: string,
    size-label: string,
    installed: bool,
    active: bool,
}

export component AppTray inherits SystemTrayIcon {
    in property <image> app-icon;

    callback quick-capture();
    callback show-main();
    callback quit();

    icon: root.app-icon;
    tooltip: "AzusaOCR · PrtSc quick region capture";
    title: "AzusaOCR";
    clicked => { root.show-main(); }

    Menu {
        MenuItem {
            title: "Capture region (PrtSc)";
            activated => { root.quick-capture(); }
        }
        MenuItem {
            title: "Show AzusaOCR";
            activated => { root.show-main(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

export component RegionOverlay inherits Window {
    in-out property <image> screenshot;

    private property <float> start-x: 0;
    private property <float> start-y: 0;
    private property <float> end-x: 0;
    private property <float> end-y: 0;
    private property <float> selection-x: min(root.start-x, root.end-x);
    private property <float> selection-y: min(root.start-y, root.end-y);
    private property <float> selection-width: abs(root.end-x - root.start-x);
    private property <float> selection-height: abs(root.end-y - root.start-y);
    private property <bool> has-selection: root.selection-width >= 2 && root.selection-height >= 2;

    callback selection-confirmed(float, float, float, float);
    callback cancelled();

    title: "AzusaOCR Region Capture";
    full-screen: true;
    always-on-top: true;
    background: black;
    forward-focus: key-handler;

    Image {
        source: root.screenshot;
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }

    if !root.has-selection: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000055;
    }
    if root.has-selection: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.selection-y * 1px;
        background: #00000088;
    }
    if root.has-selection: Rectangle {
        x: 0px;
        y: (root.selection-y + root.selection-height) * 1px;
        width: parent.width;
        height: max(0px, parent.height - self.y);
        background: #00000088;
    }
    if root.has-selection: Rectangle {
        x: 0px;
        y: root.selection-y * 1px;
        width: root.selection-x * 1px;
        height: root.selection-height * 1px;
        background: #00000088;
    }
    if root.has-selection: Rectangle {
        x: (root.selection-x + root.selection-width) * 1px;
        y: root.selection-y * 1px;
        width: max(0px, parent.width - self.x);
        height: root.selection-height * 1px;
        background: #00000088;
    }
    if root.has-selection: Rectangle {
        x: root.selection-x * 1px;
        y: root.selection-y * 1px;
        width: root.selection-width * 1px;
        height: root.selection-height * 1px;
        background: transparent;
        border-color: #ffffff;
        border-width: 2px;
    }

    Rectangle {
        x: 24px;
        y: 22px;
        width: 330px;
        height: 42px;
        border-radius: 12px;
        background: #11141ddd;
        Text {
            text: "Drag to select · release to capture · Esc to cancel";
            color: white;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    capture-area := TouchArea {
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-x = self.mouse-x / 1px;
                root.start-y = self.mouse-y / 1px;
                root.end-x = root.start-x;
                root.end-y = root.start-y;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.end-x = self.mouse-x / 1px;
                root.end-y = self.mouse-y / 1px;
                if (root.has-selection) {
                    root.selection-confirmed(
                        root.selection-x,
                        root.selection-y,
                        root.selection-width,
                        root.selection-height
                    );
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.end-x = self.mouse-x / 1px;
                root.end-y = self.mouse-y / 1px;
            }
        }
    }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                accept
            } else {
                reject
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> platform-name: "Unknown";
    in property <string> hotkey-name: "Not configured";
    in property <string> ocr-engine-name: "Not configured";
    in-out property <string> status-text: "Ready";
    in-out property <image> preview-image;
    in-out property <bool> has-capture: false;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> text-entry-visible: false;
    in-out property <string> pending-text: "";
    in-out property <string> active-tool: "rectangle";
    in-out property <int> active-color: 0;
    in-out property <float> active-stroke: 4;
    in-out property <float> capture-width: 0;
    in-out property <float> capture-height: 0;
    in-out property <float> zoom-factor: 1;
    in-out property <float> pan-x: 0;
    in-out property <float> pan-y: 0;
    in-out property <bool> has-selection: false;
    in-out property <float> object-selection-x: 0;
    in-out property <float> object-selection-y: 0;
    in-out property <float> object-selection-width: 0;
    in-out property <float> object-selection-height: 0;
    in-out property <[OcrOverlayItem]> ocr-items;
    in-out property <string> ocr-text: "";
    in-out property <int> ocr-line-count: 0;
    in-out property <bool> ocr-overlay-visible: false;
    in-out property <bool> ocr-running: false;
    in-out property <int> ocr-epoch: 0;
    in-out property <int> ocr-selection-anchor: -1;
    in-out property <int> ocr-selection-focus: -1;
    in-out property <int> ocr-hover-index: -1;
    in-out property <bool> settings-visible: false;
    in-out property <[OcrModelItem]> ocr-models;
    in-out property <string> ocr-model-busy-id: "";
    in-out property <float> ocr-model-progress: -1;
    in-out property <string> ocr-model-progress-label: "";
    in-out property <bool> ocr-model-cancellable: false;
    in-out property <string> ocr-model-error-id: "";
    in-out property <string> ocr-model-error-text: "";

    callback capture-requested();
    callback copy-requested();
    callback save-requested();
    callback ocr-requested();
    callback copy-ocr-requested();
    callback ocr-hit-test(float, float) -> int;
    callback copy-ocr-selection-requested(int, int);
    callback ocr-selection-to-text-requested(int, int);
    callback ocr-model-download-requested(string);
    callback ocr-model-cancel-requested(string);
    callback ocr-model-enable-requested(string);
    callback ocr-model-delete-requested(string);
    callback tool-selected(string);
    callback color-selected(int);
    callback stroke-selected(float);
    callback editor-pointer-down(float, float, float, float);
    callback editor-pointer-moved(float, float, float, float);
    callback editor-pointer-up(float, float, float, float);
    callback text-submit(string);
    callback undo-requested();
    callback redo-requested();
    callback delete-selection-requested();
    callback cancel-editor-action-requested();
    callback clear-annotations-requested();

    title: "AzusaOCR";
    width: 1120px;
    height: 820px;
    background: #0d0f14;
    forward-focus: editor-keys;

    editor-keys := FocusScope {
        width: parent.width;
        height: parent.height;

        KeyBinding {
            keys: @keys(Control + Z);
            enabled: !root.text-entry-visible;
            activated => { root.undo-requested(); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + Z);
            enabled: !root.text-entry-visible;
            activated => { root.redo-requested(); }
        }
        KeyBinding {
            keys: @keys(Control + Y);
            enabled: !root.text-entry-visible;
            activated => { root.redo-requested(); }
        }
        KeyBinding {
            keys: @keys(Control + C);
            enabled: !root.text-entry-visible && root.has-capture;
            activated => {
                if (root.ocr-overlay-visible && root.ocr-selection-anchor >= 0 && root.ocr-selection-focus >= 0) {
                    root.copy-ocr-selection-requested(root.ocr-selection-anchor, root.ocr-selection-focus);
                } else {
                    root.copy-requested();
                }
            }
        }
        KeyBinding {
            keys: @keys(Control + S);
            enabled: !root.text-entry-visible && root.has-capture;
            activated => { root.save-requested(); }
        }
        KeyBinding {
            keys: @keys(Control + Plus);
            enabled: !root.text-entry-visible && root.has-capture;
            activated => { root.zoom-factor = min(8, root.zoom-factor * 1.2); }
        }
        KeyBinding {
            keys: @keys(Control + HyphenMinus);
            enabled: !root.text-entry-visible && root.has-capture;
            activated => {
                root.zoom-factor = max(1, root.zoom-factor / 1.2);
                if (root.zoom-factor <= 1) { root.pan-x = 0; root.pan-y = 0; }
            }
        }
        KeyBinding {
            keys: @keys(Control + Digit0);
            enabled: !root.text-entry-visible && root.has-capture;
            activated => {
                root.zoom-factor = 1;
                root.pan-x = 0;
                root.pan-y = 0;
            }
        }
        KeyBinding {
            keys: @keys(Delete);
            enabled: !root.text-entry-visible && root.has-selection;
            activated => { root.delete-selection_requested(); }
        }
        KeyBinding {
            keys: @keys(Backspace);
            enabled: !root.text-entry-visible && root.has-selection;
            activated => { root.delete-selection_requested(); }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => { if (root.settings-visible) { root.settings-visible = false; } else { root.cancel-editor-action-requested(); } }
        }

        main-content := VerticalLayout {
            visible: !root.settings-visible;
            width: parent.width;
            height: parent.height;
            padding: 22px;
            spacing: 12px;

            HorizontalLayout {
                height: 48px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "AzusaOCR";
                        color: #f7f8fb;
                        font-size: 26px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Capture · Annotate · Local OCR";
                        color: #818b9e;
                        font-size: 12px;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: root.platform-name + " · " + root.hotkey-name;
                    color: #737e92;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Button {
                    text: "Settings";
                    clicked => { root.settings-visible = true; }
                }
                Button {
                    text: "New capture";
                    clicked => { root.capture-requested(); }
                }
            }

            Rectangle {
                height: 42px;
                border-radius: 12px;
                background: #151922;
                border-color: #262d3a;
                border-width: 1px;
                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: root.status-text;
                    color: #b7c0cf;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 84px;
                border-radius: 14px;
                background: #12161e;
                border-color: #252c39;
                border-width: 1px;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 7px;
                        ToolChip { label: "Select"; selected: root.active-tool == "select"; chosen => { root.active-tool = "select"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Rectangle"; selected: root.active-tool == "rectangle"; chosen => { root.active-tool = "rectangle"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Ellipse"; selected: root.active-tool == "ellipse"; chosen => { root.active-tool = "ellipse"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Arrow"; selected: root.active-tool == "arrow"; chosen => { root.active-tool = "arrow"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Line"; selected: root.active-tool == "line"; chosen => { root.active-tool = "line"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Pen"; selected: root.active-tool == "pen"; chosen => { root.active-tool = "pen"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Text"; selected: root.active-tool == "text"; chosen => { root.active-tool = "text"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Number"; selected: root.active-tool == "number"; chosen => { root.active-tool = "number"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Mosaic"; selected: root.active-tool == "mosaic"; chosen => { root.active-tool = "mosaic"; root.tool-selected(root.active-tool); } }
                        ToolChip { label: "Blur"; selected: root.active-tool == "blur"; chosen => { root.active-tool = "blur"; root.tool-selected(root.active-tool); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "Delete"; enabled: root.has-selection; clicked => { root.delete-selection-requested(); } }
                        Button { text: "Undo"; enabled: root.can-undo; clicked => { root.undo-requested(); } }
                        Button { text: "Redo"; enabled: root.can-redo; clicked => { root.redo-requested(); } }
                        Button { text: "Clear"; enabled: root.can-undo; clicked => { root.clear-annotations-requested(); } }
                    }
                    HorizontalLayout {
                        spacing: 7px;
                        Text { text: root.has-selection ? "Object color" : "Color"; color: #778297; font-size: 11px; vertical-alignment: center; }
                        ColorChip { swatch-color: #ef4444; selected: root.active-color == 0; chosen => { root.active-color = 0; root.color-selected(0); } }
                        ColorChip { swatch-color: #f97316; selected: root.active-color == 1; chosen => { root.active-color = 1; root.color-selected(1); } }
                        ColorChip { swatch-color: #eab308; selected: root.active-color == 2; chosen => { root.active-color = 2; root.color-selected(2); } }
                        ColorChip { swatch-color: #22c55e; selected: root.active-color == 3; chosen => { root.active-color = 3; root.color-selected(3); } }
                        ColorChip { swatch-color: #3b82f6; selected: root.active-color == 4; chosen => { root.active-color = 4; root.color-selected(4); } }
                        ColorChip { swatch-color: #8b5cf6; selected: root.active-color == 5; chosen => { root.active-color = 5; root.color-selected(5); } }
                        ColorChip { swatch-color: white; selected: root.active-color == 6; chosen => { root.active-color = 6; root.color-selected(6); } }
                        ColorChip { swatch-color: #111827; selected: root.active-color == 7; chosen => { root.active-color = 7; root.color-selected(7); } }
                        Rectangle { width: 10px; background: transparent; }
                        Text { text: root.has-selection ? "Object size" : "Size"; color: #778297; font-size: 11px; vertical-alignment: center; }
                        StrokeChip { label: "2"; selected: root.active-stroke == 2; chosen => { root.active-stroke = 2; root.stroke-selected(2); } }
                        StrokeChip { label: "4"; selected: root.active-stroke == 4; chosen => { root.active-stroke = 4; root.stroke-selected(4); } }
                        StrokeChip { label: "8"; selected: root.active-stroke == 8; chosen => { root.active-stroke = 8; root.stroke-selected(8); } }
                        StrokeChip { label: "12"; selected: root.active-stroke == 12; chosen => { root.active-stroke = 12; root.stroke-selected(12); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: "OCR: " + root.ocr-engine-name; color: #69758a; font-size: 10px; vertical-alignment: center; }
                    }
                }
            }

            editor-canvas := Rectangle {
                vertical-stretch: 1;
                background: #080a0e;
                border-color: #252c38;
                border-width: 1px;
                border-radius: 14px;
                clip: true;

                private property <float> canvas-width-px: self.width / 1px;
                private property <float> canvas-height-px: self.height / 1px;
                private property <float> fit-scale: root.capture-width > 0 && root.capture-height > 0
                    ? min(self.canvas-width-px / root.capture-width, self.canvas-height-px / root.capture-height)
                    : 1;
                private property <length> fit-display-width: root.capture-width * self.fit-scale * 1px;
                private property <length> fit-display-height: root.capture-height * self.fit-scale * 1px;
                private property <length> fit-offset-x: (self.width - self.fit-display-width) / 2;
                private property <length> fit-offset-y: (self.height - self.fit-display-height) / 2;
                private property <float> image-scale: self.fit-scale * root.zoom-factor;
                private property <length> image-display-width: root.capture-width * self.image-scale * 1px;
                private property <length> image-display-height: root.capture-height * self.image-scale * 1px;
                private property <float> max-pan-x: max(0, (self.image-display-width - self.width) / 2 / 1px);
                private property <float> max-pan-y: max(0, (self.image-display-height - self.height) / 2 / 1px);
                private property <float> effective-pan-x: max(-self.max-pan-x, min(self.max-pan-x, root.pan-x));
                private property <float> effective-pan-y: max(-self.max-pan-y, min(self.max-pan-y, root.pan-y));
                private property <length> image-offset-x: (self.width - self.image-display-width) / 2 + self.effective-pan-x * 1px;
                private property <length> image-offset-y: (self.height - self.image-display-height) / 2 + self.effective-pan-y * 1px;

                if root.has-capture: Image {
                    x: editor-canvas.image-offset-x;
                    y: editor-canvas.image-offset-y;
                    width: editor-canvas.image-display-width;
                    height: editor-canvas.image-display-height;
                    source: root.preview-image;
                    image-fit: fill;
                }

                if root.has-selection: selection-outline := Rectangle {
                    x: editor-canvas.image-offset-x + root.object-selection-x * editor-canvas.image-scale * 1px;
                    y: editor-canvas.image-offset-y + root.object-selection-y * editor-canvas.image-scale * 1px;
                    width: root.object-selection-width * editor-canvas.image-scale * 1px;
                    height: root.object-selection-height * editor-canvas.image-scale * 1px;
                    background: transparent;
                    border-color: #a996f2;
                    border-width: 2px;

                    SelectionHandle { x: -5px; y: -5px; }
                    SelectionHandle { x: parent.width / 2 - 5px; y: -5px; }
                    SelectionHandle { x: parent.width - 5px; y: -5px; }
                    SelectionHandle { x: parent.width - 5px; y: parent.height / 2 - 5px; }
                    SelectionHandle { x: parent.width - 5px; y: parent.height - 5px; }
                    SelectionHandle { x: parent.width / 2 - 5px; y: parent.height - 5px; }
                    SelectionHandle { x: -5px; y: parent.height - 5px; }
                    SelectionHandle { x: -5px; y: parent.height / 2 - 5px; }
                }

                if root.has-capture: viewport-input := TouchArea {
                    visible: !root.ocr-overlay-visible;
                    private property <bool> panning: false;
                    private property <float> pan-start-x: 0;
                    private property <float> pan-start-y: 0;
                    private property <float> pointer-start-x: 0;
                    private property <float> pointer-start-y: 0;
                    private property <float> mapped-x: editor-canvas.fit-offset-x / 1px
                        + ((self.mouse-x - editor-canvas.image-offset-x) / 1px)
                            / editor-canvas.image-scale * editor-canvas.fit-scale;
                    private property <float> mapped-y: editor-canvas.fit-offset-y / 1px
                        + ((self.mouse-y - editor-canvas.image-offset-y) / 1px)
                            / editor-canvas.image-scale * editor-canvas.fit-scale;

                    mouse-cursor: self.panning ? grabbing : (root.active-tool == "select" ? pointer : crosshair);
                    pointer-event(event) => {
                        if ((event.button == PointerEventButton.middle || event.button == PointerEventButton.right)
                            && event.kind == PointerEventKind.down && root.zoom-factor > 1) {
                            self.panning = true;
                            self.pan-start-x = editor-canvas.effective-pan-x;
                            self.pan-start-y = editor-canvas.effective-pan-y;
                            self.pointer-start-x = self.mouse-x / 1px;
                            self.pointer-start-y = self.mouse-y / 1px;
                        }
                        if ((event.button == PointerEventButton.middle || event.button == PointerEventButton.right)
                            && event.kind == PointerEventKind.up) {
                            self.panning = false;
                        }
                        if (event.kind == PointerEventKind.cancel) { self.panning = false; }
                        if (!self.panning && event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.editor-pointer-down(self.mapped-x * root.zoom-factor, self.mapped-y * root.zoom-factor, self.width / 1px * root.zoom-factor, self.height / 1px * root.zoom-factor);
                        }
                        if (!self.panning && event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.editor-pointer-up(self.mapped-x * root.zoom-factor, self.mapped-y * root.zoom-factor, self.width / 1px * root.zoom-factor, self.height / 1px * root.zoom-factor);
                        }
                    }
                    moved => {
                        if (self.panning) {
                            root.pan-x = max(-editor-canvas.max-pan-x, min(editor-canvas.max-pan-x, self.pan-start-x + self.mouse-x / 1px - self.pointer-start-x));
                            root.pan-y = max(-editor-canvas.max-pan-y, min(editor-canvas.max-pan-y, self.pan-start-y + self.mouse-y / 1px - self.pointer-start-y));
                        } else if (self.pressed) {
                            root.editor-pointer-moved(self.mapped-x * root.zoom-factor, self.mapped-y * root.zoom-factor, self.width / 1px * root.zoom-factor, self.height / 1px * root.zoom-factor);
                        }
                    }
                    scroll-event(event) => {
                        if (event.delta-y < 0px) {
                            root.zoom-factor = min(8, root.zoom-factor * 1.15);
                        } else if (event.delta-y > 0px) {
                            root.zoom-factor = max(1, root.zoom-factor / 1.15);
                            if (root.zoom-factor <= 1) { root.pan-x = 0; root.pan-y = 0; }
                        }
                        accept
                    }
                }

                for item[index] in root.ocr-items : Path {
                    visible: root.ocr-overlay-visible;
                    x: 0px;
                    y: 0px;
                    width: editor-canvas.width;
                    height: editor-canvas.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: editor-canvas.canvas-width-px;
                    viewbox-height: editor-canvas.canvas-height-px;
                    fill: root.ocr-selection-anchor >= 0 && root.ocr-selection-focus >= 0
                        && index >= min(root.ocr-selection-anchor, root.ocr-selection-focus)
                        && index <= max(root.ocr-selection-anchor, root.ocr-selection-focus)
                            ? #8b5cf638
                            : root.ocr-hover-index == index ? #22d3ee24 : transparent;
                    stroke: root.ocr-selection-anchor >= 0 && root.ocr-selection-focus >= 0
                        && index >= min(root.ocr-selection-anchor, root.ocr-selection-focus)
                        && index <= max(root.ocr-selection-anchor, root.ocr-selection-focus)
                            ? #a996f2
                            : root.ocr-hover-index == index ? #67e8f9 : transparent;
                    stroke-width: root.ocr-selection-anchor >= 0 && root.ocr-selection-focus >= 0
                        && index >= min(root.ocr-selection-anchor, root.ocr-selection-focus)
                        && index <= max(root.ocr-selection-anchor, root.ocr-selection-focus) ? 2px
                        : root.ocr-hover-index == index ? 1px : 0px;

                    MoveTo { x: editor-canvas.image-offset-x / 1px + item.p0-x * editor-canvas.image-scale; y: editor-canvas.image-offset-y / 1px + item.p0-y * editor-canvas.image-scale; }
                    LineTo { x: editor-canvas.image-offset-x / 1px + item.p1-x * editor-canvas.image-scale; y: editor-canvas.image-offset-y / 1px + item.p1-y * editor-canvas.image-scale; }
                    LineTo { x: editor-canvas.image-offset-x / 1px + item.p2-x * editor-canvas.image-scale; y: editor-canvas.image-offset-y / 1px + item.p2-y * editor-canvas.image-scale; }
                    LineTo { x: editor-canvas.image-offset-x / 1px + item.p3-x * editor-canvas.image-scale; y: editor-canvas.image-offset-y / 1px + item.p3-y * editor-canvas.image-scale; }
                    Close { }
                }

                if root.ocr-overlay-visible: ocr-text-context := ContextMenuArea {
                    width: parent.width;
                    height: parent.height;

                    Menu {
                        MenuItem {
                            title: "Copy";
                            enabled: root.ocr-selection-anchor >= 0 && root.ocr-selection-focus >= 0;
                            activated => { root.copy-ocr-selection-requested(root.ocr-selection-anchor, root.ocr-selection-focus); }
                        }
                        MenuItem {
                            title: "Create text annotation";
                            enabled: root.ocr-selection-anchor >= 0 && root.ocr-selection-focus >= 0;
                            activated => { root.ocr-selection-to-text-requested(root.ocr-selection-anchor, root.ocr-selection-focus); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: "Copy all text";
                            enabled: root.ocr-line-count > 0;
                            activated => { root.copy-ocr-requested(); }
                        }
                    }

                    ocr-text-input := TouchArea {
                        private property <bool> selecting: false;
                        private property <bool> panning: false;
                        private property <float> pan-start-x: 0;
                        private property <float> pan-start-y: 0;
                        private property <float> pointer-start-x: 0;
                        private property <float> pointer-start-y: 0;
                        private property <float> image-x: ((self.mouse-x - editor-canvas.image-offset-x) / 1px) / editor-canvas.image-scale;
                        private property <float> image-y: ((self.mouse-y - editor-canvas.image-offset-y) / 1px) / editor-canvas.image-scale;

                        mouse-cursor: self.panning ? grabbing : text;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.down && root.zoom-factor > 1) {
                                self.panning = true;
                                self.pan-start-x = editor-canvas.effective-pan-x;
                                self.pan-start-y = editor-canvas.effective-pan-y;
                                self.pointer-start-x = self.mouse-x / 1px;
                                self.pointer-start-y = self.mouse-y / 1px;
                            }
                            if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up) { self.panning = false; }
                            if (event.kind == PointerEventKind.cancel) { self.panning = false; self.selecting = false; }
                            if (!self.panning && event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.ocr-hover-index = root.ocr-hit-test(self.image-x, self.image-y);
                                root.ocr-selection-anchor = root.ocr-hover-index;
                                root.ocr-selection-focus = root.ocr-hover-index;
                                self.selecting = root.ocr-hover-index >= 0;
                            }
                            if (!self.panning && event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                self.selecting = false;
                                if (root.ocr-selection-anchor >= 0 && root.ocr-selection-focus >= 0) {
                                    root.status-text = "OCR text selected · drag across lines or right-click for actions";
                                }
                            }
                            if (!self.panning && event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.ocr-hover-index = root.ocr-hit-test(self.image-x, self.image-y);
                                if (root.ocr-hover-index >= 0 && (
                                    root.ocr-selection-anchor < 0 || root.ocr-selection-focus < 0
                                    || root.ocr-hover-index < min(root.ocr-selection-anchor, root.ocr-selection-focus)
                                    || root.ocr-hover-index > max(root.ocr-selection-anchor, root.ocr-selection-focus))) {
                                    root.ocr-selection-anchor = root.ocr-hover-index;
                                    root.ocr-selection-focus = root.ocr-hover-index;
                                }
                            }
                        }
                        moved => {
                            if (self.panning) {
                                root.pan-x = max(-editor-canvas.max-pan-x, min(editor-canvas.max-pan-x, self.pan-start-x + self.mouse-x / 1px - self.pointer-start-x));
                                root.pan-y = max(-editor-canvas.max-pan-y, min(editor-canvas.max-pan-y, self.pan-start-y + self.mouse-y / 1px - self.pointer-start-y));
                            } else {
                                root.ocr-hover-index = root.ocr-hit-test(self.image-x, self.image-y);
                                if (self.selecting && root.ocr-hover-index >= 0) { root.ocr-selection-focus = root.ocr-hover-index; }
                            }
                        }
                        scroll-event(event) => {
                            if (event.delta-y < 0px) { root.zoom-factor = min(8, root.zoom-factor * 1.15); }
                            else if (event.delta-y > 0px) {
                                root.zoom-factor = max(1, root.zoom-factor / 1.15);
                                if (root.zoom-factor <= 1) { root.pan-x = 0; root.pan-y = 0; }
                            }
                            accept
                        }
                    }
                }

                if !root.has-capture: VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: "No screenshot loaded";
                        color: #a5afbf;
                        font-size: 18px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Press PrtSc or choose New capture to select a region.";
                        color: #626d80;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }

                if root.text-entry-visible: Rectangle {
                    x: 16px;
                    y: parent.height - 62px;
                    width: min(560px, parent.width - 32px);
                    height: 46px;
                    border-radius: 12px;
                    background: #171b25ee;
                    border-color: #7c5ce6;
                    border-width: 1px;
                    HorizontalLayout {
                        padding: 7px;
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #0e1118;
                            border-radius: 8px;
                            TextInput {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 16px;
                                height: parent.height - 8px;
                                text <=> root.pending-text;
                                color: #f4f6fb;
                                font-size: 14px;
                                single-line: true;
                            }
                        }
                        Button {
                            text: "Add text";
                            enabled: root.pending-text != "";
                            clicked => { root.text-submit(root.pending-text); }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 40px;
                spacing: 8px;
                Text {
                    text: !root.has-capture
                        ? "Capture a region to start editing"
                        : root.active-tool == "select"
                            ? "Select objects to move, resize, recolor or delete · wheel zoom · middle/right drag pan"
                            : "Drag on the image to annotate · wheel zoom · middle/right drag pan";
                    color: #687386;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button {
                    text: "−";
                    enabled: root.has-capture && root.zoom-factor > 1;
                    clicked => {
                        root.zoom-factor = max(1, root.zoom-factor / 1.2);
                        if (root.zoom-factor <= 1) { root.pan-x = 0; root.pan-y = 0; }
                    }
                }
                Button {
                    text: "Fit";
                    enabled: root.has-capture && (root.zoom-factor != 1 || root.pan-x != 0 || root.pan-y != 0);
                    clicked => { root.zoom-factor = 1; root.pan-x = 0; root.pan-y = 0; }
                }
                Button {
                    text: "+";
                    enabled: root.has-capture && root.zoom-factor < 8;
                    clicked => { root.zoom-factor = min(8, root.zoom-factor * 1.2); }
                }
                Button {
                    text: root.ocr-running ? "OCR…" : "OCR";
                    enabled: root.has-capture && !root.ocr-running && root.ocr-model-busy-id == "";
                    clicked => { root.ocr-requested(); }
                }
                Button {
                    text: root.ocr-overlay-visible ? "Hide text layer" : "Show text layer";
                    enabled: root.ocr-line-count > 0;
                    clicked => {
                        root.ocr-overlay-visible = !root.ocr-overlay-visible;
                        if (!root.ocr-overlay-visible) {
                            root.ocr-selection-anchor = -1;
                            root.ocr-selection-focus = -1;
                            root.ocr-hover-index = -1;
                        } else {
                            root.status-text = "OCR text layer active · drag across recognized text · right-click for actions";
                        }
                    }
                }
                Button {
                    text: "Copy all text";
                    enabled: root.ocr-line-count > 0;
                    clicked => { root.copy-ocr-requested(); }
                }

                Button { text: "Copy edited"; enabled: root.has-capture; clicked => { root.copy-requested(); } }
                Button { text: "Save PNG"; enabled: root.has-capture; clicked => { root.save-requested(); } }
            }
        }

        settings-content := VerticalLayout {
            visible: root.settings-visible;
            width: parent.width;
            height: parent.height;
            padding: 22px;
            spacing: 16px;

            HorizontalLayout {
                height: 50px;
                spacing: 12px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "Settings"; color: #f7f8fb; font-size: 26px; font-weight: 700; }
                    Text { text: "Local capabilities are explicit and user-managed"; color: #818b9e; font-size: 12px; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button { text: "Close"; clicked => { root.settings-visible = false; } }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: 14px;
                background: #10141c;
                border-color: #252c39;
                border-width: 1px;
                HorizontalLayout {
                    padding: 14px;
                    spacing: 14px;
                    Rectangle {
                        width: 210px;
                        border-radius: 12px;
                        background: #151a24;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text { text: "APPLICATION"; color: #6f7b90; font-size: 10px; font-weight: 600; }
                            Button { text: "OCR models"; enabled: false; }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 12px;
                        background: #0d1118;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            Text { text: "OCR model management"; color: #f1f4f9; font-size: 20px; font-weight: 650; }
                            Text { text: "OCR never downloads a model automatically. Download here, then explicitly enable the model you want to use."; color: #8994a7; font-size: 12px; }
                            Text { text: "One model operation runs at a time. Active downloads can be cancelled safely and retried."; color: #748198; font-size: 11px; }
                            Text { text: "Active model: " + root.ocr-engine-name; color: #aab4c4; font-size: 12px; }

                            ListView {
                                vertical-stretch: 1;
                                for model in root.ocr-models : Rectangle {
                                    height: 214px;
                                    width: parent.width;
                                    border-radius: 12px;
                                    background: #151a23;
                                    border-color: model.active ? #7c5ce6 : #2a3240;
                                    border-width: model.active ? 2px : 1px;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 7px;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                spacing: 3px;
                                                Text { text: model.name; color: #f4f6fa; font-size: 15px; font-weight: 650; }
                                                Text { text: model.version + " · " + model.size-label; color: #748198; font-size: 10px; }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            Text {
                                                text: root.ocr-model-busy-id == model.id
                                                    ? root.ocr-model-cancellable ? "DOWNLOADING" : "WORKING"
                                                    : model.active ? "ACTIVE" : model.installed ? "INSTALLED" : "NOT INSTALLED";
                                                color: root.ocr-model-busy-id == model.id ? #d8ccff
                                                    : model.active ? #b7a5ff : model.installed ? #8bd6a8 : #8b96a8;
                                                font-size: 10px;
                                                font-weight: 650;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text { text: model.languages; color: #a0aabd; font-size: 11px; }

                                        if root.ocr-model-busy-id == model.id: VerticalLayout {
                                            height: 34px;
                                            spacing: 5px;
                                            Text {
                                                text: root.ocr-model-progress-label;
                                                color: #b9c2d2;
                                                font-size: 10px;
                                                overflow: elide;
                                            }
                                            Rectangle {
                                                height: 6px;
                                                border-radius: 3px;
                                                background: #252c39;
                                                Rectangle {
                                                    width: root.ocr-model-progress >= 0
                                                        ? parent.width * max(0, min(1, root.ocr-model-progress))
                                                        : parent.width * 0.18;
                                                    height: parent.height;
                                                    border-radius: 3px;
                                                    background: #7c5ce6;
                                                }
                                            }
                                        }

                                        if root.ocr-model-error-id == model.id && root.ocr-model-error-text != "": Text {
                                            height: 34px;
                                            text: root.ocr-model-error-text;
                                            color: #fca5a5;
                                            font-size: 10px;
                                            wrap: word-wrap;
                                            overflow: clip;
                                        }

                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: root.ocr-model-busy-id == model.id
                                                    ? root.ocr-model-cancellable ? "Cancel" : "Working…"
                                                    : model.installed ? model.active ? "Enabled" : "Enable" : "Download";
                                                enabled: !root.ocr-running && !model.active
                                                    && (root.ocr-model-busy-id == ""
                                                        || (root.ocr-model-busy-id == model.id && root.ocr-model-cancellable));
                                                clicked => {
                                                    if (root.ocr-model-busy-id == model.id && root.ocr-model-cancellable) {
                                                        root.ocr-model-cancel-requested(model.id);
                                                    } else if (model.installed) {
                                                        root.ocr-model-enable-requested(model.id);
                                                    } else {
                                                        root.ocr-model-download-requested(model.id);
                                                    }
                                                }
                                            }
                                            Button {
                                                text: "Delete";
                                                visible: model.installed;
                                                enabled: !root.ocr-running && root.ocr-model-busy-id == "";
                                                clicked => { root.ocr-model-delete-requested(model.id); }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
