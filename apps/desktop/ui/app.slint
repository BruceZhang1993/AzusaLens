import { Button } from "std-widgets.slint";

component InfoCard inherits Rectangle {
    in property <string> heading;
    in property <string> value;
    in property <string> description;

    background: #171a22;
    border-color: #252a36;
    border-width: 1px;
    border-radius: 16px;
    height: 122px;

    VerticalLayout {
        padding: 18px;
        spacing: 7px;

        Text {
            text: root.heading;
            color: #8d96a8;
            font-size: 13px;
        }
        Text {
            text: root.value;
            color: #f4f6fb;
            font-size: 18px;
            font-weight: 600;
        }
        Text {
            text: root.description;
            color: #aab2c2;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    in property <image> app-icon;

    callback quick-capture();
    callback show-main();
    callback quit();

    icon: root.app-icon;
    tooltip: "AzusaOCR · PrtSc quick region capture";
    title: "AzusaOCR";
    clicked => { root.show-main(); }

    Menu {
        MenuItem {
            title: "Capture region (PrtSc)";
            activated => { root.quick-capture(); }
        }
        MenuItem {
            title: "Show AzusaOCR";
            activated => { root.show-main(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

export component RegionOverlay inherits Window {
    in-out property <image> screenshot;

    private property <float> start-x: 0;
    private property <float> start-y: 0;
    private property <float> end-x: 0;
    private property <float> end-y: 0;
    private property <float> selection-x: min(root.start-x, root.end-x);
    private property <float> selection-y: min(root.start-y, root.end-y);
    private property <float> selection-width: abs(root.end-x - root.start-x);
    private property <float> selection-height: abs(root.end-y - root.start-y);
    private property <bool> has-selection: root.selection-width >= 2 && root.selection-height >= 2;

    callback selection-confirmed(float, float, float, float);
    callback cancelled();

    title: "AzusaOCR Region Capture";
    full-screen: true;
    always-on-top: true;
    background: black;
    forward-focus: key-handler;

    Image {
        source: root.screenshot;
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }

    if !root.has-selection: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000055;
    }

    if root.has-selection: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.selection-y * 1px;
        background: #00000088;
    }
    if root.has-selection: Rectangle {
        x: 0px;
        y: (root.selection-y + root.selection-height) * 1px;
        width: parent.width;
        height: max(0px, parent.height - self.y);
        background: #00000088;
    }
    if root.has-selection: Rectangle {
        x: 0px;
        y: root.selection-y * 1px;
        width: root.selection-x * 1px;
        height: root.selection-height * 1px;
        background: #00000088;
    }
    if root.has-selection: Rectangle {
        x: (root.selection-x + root.selection-width) * 1px;
        y: root.selection-y * 1px;
        width: max(0px, parent.width - self.x);
        height: root.selection-height * 1px;
        background: #00000088;
    }

    if root.has-selection: Rectangle {
        x: root.selection-x * 1px;
        y: root.selection-y * 1px;
        width: root.selection-width * 1px;
        height: root.selection-height * 1px;
        background: transparent;
        border-color: #ffffff;
        border-width: 2px;
    }

    Rectangle {
        x: 24px;
        y: 22px;
        width: 330px;
        height: 42px;
        border-radius: 12px;
        background: #11141ddd;
        Text {
            text: "Drag to select · release to capture · Esc to cancel";
            color: white;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    capture-area := TouchArea {
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-x = self.mouse-x / 1px;
                root.start-y = self.mouse-y / 1px;
                root.end-x = root.start-x;
                root.end-y = root.start-y;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.end-x = self.mouse-x / 1px;
                root.end-y = self.mouse-y / 1px;
                if (root.has-selection) {
                    root.selection-confirmed(
                        root.selection-x,
                        root.selection-y,
                        root.selection-width,
                        root.selection-height
                    );
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.end-x = self.mouse-x / 1px;
                root.end-y = self.mouse-y / 1px;
            }
        }
    }

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                accept
            } else {
                reject
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> platform-name: "Unknown";
    in property <string> hotkey-name: "Not configured";
    in property <string> ocr-engine-name: "Not configured";
    in-out property <string> status-text: "Ready";
    in-out property <image> preview-image;
    in-out property <bool> has-capture: false;

    callback capture-requested();
    callback copy-requested();
    callback save-requested();
    callback ocr-requested();

    title: "AzusaOCR";
    width: 1040px;
    height: 780px;
    background: #0d0f14;

    VerticalLayout {
        padding: 28px;
        spacing: 18px;

        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "AzusaOCR";
                    color: #f7f8fb;
                    font-size: 30px;
                    font-weight: 700;
                }
                Text {
                    text: "Native screenshot · Local OCR · Annotation";
                    color: #8f98aa;
                    font-size: 14px;
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #79d79a;
            }
            Text {
                text: "Region Capture";
                color: #aeb6c5;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 82px;
            background: #12151c;
            border-color: #252a36;
            border-width: 1px;
            border-radius: 18px;

            VerticalLayout {
                padding: 16px;
                spacing: 6px;
                Text {
                    text: "Runtime status";
                    color: #8d96a8;
                    font-size: 12px;
                }
                Text {
                    text: root.status-text;
                    color: #f4f6fb;
                    font-size: 14px;
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;
            InfoCard {
                horizontal-stretch: 1;
                heading: "CAPTURE";
                value: root.platform-name;
                description: "Wayland uses the native screenshot portal; other desktops use a frozen-frame overlay.";
            }
            InfoCard {
                horizontal-stretch: 1;
                heading: "GLOBAL HOTKEY";
                value: "PrtSc";
                description: root.hotkey-name;
            }
            InfoCard {
                horizontal-stretch: 1;
                heading: "OCR ENGINE";
                value: root.ocr-engine-name;
                description: "OCR remains isolated behind the shared engine contract.";
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #12151c;
            border-color: #252a36;
            border-width: 1px;
            border-radius: 18px;

            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.has-capture ? "Region preview" : "No capture yet";
                        color: #f4f6fb;
                        font-size: 17px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        text: "Capture region";
                        clicked => { root.capture-requested(); }
                    }
                    Button {
                        text: "Copy image";
                        enabled: root.has-capture;
                        clicked => { root.copy-requested(); }
                    }
                    Button {
                        text: "Save PNG";
                        enabled: root.has-capture;
                        clicked => { root.save-requested(); }
                    }
                    Button {
                        text: "OCR";
                        enabled: root.has-capture;
                        clicked => { root.ocr-requested(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: #090b0f;
                    border-color: #252a36;
                    border-width: 1px;
                    border-radius: 12px;
                    clip: true;

                    if root.has-capture: Image {
                        source: root.preview-image;
                        image-fit: contain;
                        width: parent.width;
                        height: parent.height;
                    }

                    if !root.has-capture: Text {
                        text: "Press PrtSc or use Capture region. Closing this window keeps AzusaOCR available in the system tray.";
                        color: #697386;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
        }

        Text {
            text: "0.1.0-dev · Region capture · PrtSc · system tray";
            color: #636d80;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}
