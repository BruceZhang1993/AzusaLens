import { Button } from "std-widgets.slint";

component InfoCard inherits Rectangle {
    in property <string> heading;
    in property <string> value;
    in property <string> description;

    background: #171a22;
    border-color: #252a36;
    border-width: 1px;
    border-radius: 16px;
    height: 122px;

    VerticalLayout {
        padding: 18px;
        spacing: 7px;

        Text {
            text: root.heading;
            color: #8d96a8;
            font-size: 13px;
        }
        Text {
            text: root.value;
            color: #f4f6fb;
            font-size: 18px;
            font-weight: 600;
        }
        Text {
            text: root.description;
            color: #aab2c2;
            font-size: 12px;
        }
    }
}

export component AppWindow inherits Window {
    in property <string> platform-name: "Unknown";
    in property <string> ocr-engine-name: "Not configured";
    in-out property <string> status-text: "Ready";
    in-out property <image> preview-image;
    in-out property <bool> has-capture: false;

    callback capture-requested();
    callback copy-requested();
    callback save-requested();
    callback ocr-requested();

    title: "AzusaOCR";
    width: 1040px;
    height: 760px;
    background: #0d0f14;

    VerticalLayout {
        padding: 28px;
        spacing: 18px;

        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "AzusaOCR";
                    color: #f7f8fb;
                    font-size: 30px;
                    font-weight: 700;
                }
                Text {
                    text: "Native screenshot · Local OCR · Annotation";
                    color: #8f98aa;
                    font-size: 14px;
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #79d79a;
            }
            Text {
                text: "Capture MVP";
                color: #aeb6c5;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 82px;
            background: #12151c;
            border-color: #252a36;
            border-width: 1px;
            border-radius: 18px;

            VerticalLayout {
                padding: 16px;
                spacing: 6px;
                Text {
                    text: "Runtime status";
                    color: #8d96a8;
                    font-size: 12px;
                }
                Text {
                    text: root.status-text;
                    color: #f4f6fb;
                    font-size: 14px;
                }
            }
        }

        HorizontalLayout {
            spacing: 18px;
            InfoCard {
                horizontal-stretch: 1;
                heading: "CAPTURE BACKEND";
                value: root.platform-name;
                description: "MVP adapter is isolated behind the Azusa capture contract.";
            }
            InfoCard {
                horizontal-stretch: 1;
                heading: "OCR ENGINE";
                value: root.ocr-engine-name;
                description: "GLM-OCR remains isolated behind the shared OCR interface.";
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #12151c;
            border-color: #252a36;
            border-width: 1px;
            border-radius: 18px;

            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.has-capture ? "Capture preview" : "No capture yet";
                        color: #f4f6fb;
                        font-size: 17px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        text: "Capture primary display";
                        clicked => { root.capture-requested(); }
                    }
                    Button {
                        text: "Copy image";
                        enabled: root.has-capture;
                        clicked => { root.copy-requested(); }
                    }
                    Button {
                        text: "Save PNG";
                        enabled: root.has-capture;
                        clicked => { root.save-requested(); }
                    }
                    Button {
                        text: "OCR";
                        enabled: root.has-capture;
                        clicked => { root.ocr-requested(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: #090b0f;
                    border-color: #252a36;
                    border-width: 1px;
                    border-radius: 12px;
                    clip: true;

                    if root.has-capture: Image {
                        source: root.preview-image;
                        image-fit: contain;
                        width: parent.width;
                        height: parent.height;
                    }

                    if !root.has-capture: Text {
                        text: "Capture the primary display to validate pixel acquisition and preview rendering.";
                        color: #697386;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
        }

        Text {
            text: "0.1.0-dev · Capture MVP · OCR still stubbed";
            color: #636d80;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}
